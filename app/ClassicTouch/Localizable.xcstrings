      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · %@ · %d:%02d\nCPU %.0f%%（累计 %.0f 秒）· 占用 %.0f MB · 可用 %.0f MB · 帧 %d"
          }
        }
      }
    },
    "%@, %@" : {
      "comment" : "Joins two items of a short list",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@、%@"
          }
        }
      }
    },
    "%@: boot_strategy=%@ is not supported yet" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：还不支持 boot_strategy=%@"
          }
        }
      }
    },
    "%@: cannot read device.lock.json" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：device.lock.json 读不懂"
