    "Classic Touch is an open-source project made in spare time. If you enjoy it, you can buy the developer a coffee." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classic Touch 是业余时间做的开源项目。喜欢的话，可以请开发者喝杯咖啡。"
          }
        }
      }
    },
    "Classic Touch is free software, released under the GNU General Public License, version 2 or later. You are free to use, modify, and redistribute it, but it comes with no warranty." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classic Touch 是自由软件，按 GNU 通用公共许可证第 2 版或更新版本发布。可以自由使用、修改和再分发，但不提供任何担保。"
          }
        }
      }
    },
