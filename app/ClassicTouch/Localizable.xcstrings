    },
    "Boot and run the original iPhone OS and iOS of years past on your iPhone, a way for longtime fans to revisit the classics. iPhone OS 1 through iOS 10 all run except iOS 8, which will come later." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iPhone 上开机运行当年的原版 iPhone OS 和 iOS，给老玩家一个回味经典的入口。iPhone OS 1 到 iOS 10 除了 iOS 8 都能开，iOS 8 以后支持。"
          }
        }
      }
    },
