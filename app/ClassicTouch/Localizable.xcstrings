{
  "sourceLanguage" : "en",
  "strings" : {
    " %@ available on this phone." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "手机还剩 %@ 可用。"
