      }
    },
    ", " : {
      "comment" : "Between the parts of a VoiceOver label",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "，"
          }
        }
      }
    },
    "A running system can't be deleted. Switch to another one in the timeline first, or swipe the app away in the app switcher and reopen it." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在运行的系统不能删除。先在年表里换一台别的，或者把 App 从多任务里划掉再打开。"
          }
        }
      }
    },
    "A system in this pack is running; it will be imported the next time the app opens" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "包里的系统正在运行，下次打开 App 时再导入"
          }
        }
      }
    },
    "About" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
