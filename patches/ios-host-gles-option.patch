        description: 'lzo compression support')
 option('pvg', type: 'feature', value: 'auto',
        description: 'macOS paravirtualized graphics support')
+option('host_gles', type: 'feature', value: 'auto',
+       description: 'iOS host OpenGL ES (EAGL) behind the GLES bridge')
 option('rbd', type : 'feature', value : 'auto',
        description: 'Ceph block device driver')
 option('opengl', type : 'feature', value : 'auto',
diff --git a/scripts/meson-buildoptions.sh b/scripts/meson-buildoptions.sh
index ca5b113119..ba922c2f56 100644
--- a/scripts/meson-buildoptions.sh
+++ b/scripts/meson-buildoptions.sh
@@ -171,6 +171,7 @@ meson_options_help() {
   printf "%s\n" '  plugins         TCG plugins via shared library loading'
   printf "%s\n" '  png             PNG support with libpng'
   printf "%s\n" '  pvg             macOS paravirtualized graphics support'
+  printf "%s\n" '  host-gles       iOS host OpenGL ES (EAGL) behind the GLES bridge'
   printf "%s\n" '  qatzip          QATzip compression support'
   printf "%s\n" '  qcow1           qcow1 image format support'
   printf "%s\n" '  qed             qed image format support'
@@ -447,6 +448,8 @@ _meson_option_parse() {
     --prefix=*) quote_sh "-Dprefix=$2" ;;
     --enable-pvg) printf "%s" -Dpvg=enabled ;;
     --disable-pvg) printf "%s" -Dpvg=disabled ;;
+    --enable-host-gles) printf "%s" -Dhost_gles=enabled ;;
+    --disable-host-gles) printf "%s" -Dhost_gles=disabled ;;
     --enable-qatzip) printf "%s" -Dqatzip=enabled ;;
     --disable-qatzip) printf "%s" -Dqatzip=disabled ;;
     --enable-qcow1) printf "%s" -Dqcow1=enabled ;;
