+    if (!s || !s->gpio || (unsigned)button >= ARRAY_SIZE(pins)) {
+        return;
+    }
+    qemu_set_irq(qdev_get_gpio_in(s->gpio, S5L8930_GPIO_PIN(pins[button])), !down);
+}
