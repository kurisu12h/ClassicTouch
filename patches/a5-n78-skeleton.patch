+ * What the iPod touch 5 (n78) and the iPhone 5 (n41) do not share, from their DTs. Their arm-io blocks sit at
+ * the same addresses with the same AIC lines; the A6 adds i2c1 (accelerometer, light sensor, compass), moves
+ * the I2C buses' and the touch sensor's GPIOs and adds the ringer switch at pin 4.
+ */
+typedef struct N78Board {
+    const char *name;                   /* "n78", "n41": messages */
+    uint64_t dram_size;
+    unsigned i2c_buses;                 /* bit n: i2c<n> */
+    uint32_t i2c_pins[6];               /* their function-iic_sda/scl GPIOs, which rest high */
+    unsigned n_i2c_pins;
+    uint32_t mt_atn;                    /* the multi-touch sensor's DT interrupt, as a GPIO pin */
+    const MTSensorProfile *mt;
+    unsigned buttons;                   /* GPIO pins 0 .. buttons - 1: menu, hold, volup, voldown(, ringer) */
+    unsigned console_uart;              /* serial0: n78's uart1 (no uart0 in its DT), n41's uart6 (debug-console) */
+    int gauge_mah;                      /* a bq27540 HDQ gas gauge on uart5 (n41's DT), this battery; 0 none */
+    uint8_t backlight_addr;             /* an LM3534 backlight driver on i2c0 (n41's i2c0/lm3534), 7-bit; 0 none */
+    uint32_t clcd_gamma_busy;           /* the display's "gamma-busy": the A6's AppleH5PCLCD's gamma-load bit */
+    uint8_t pmu_adc_ctl;                /* the D1972's ADC control register, 0: the PMU is a plain register file */
+    unsigned pmu_irq_pin;               /* its interrupt, a GPIO (DT pmu interrupts) */
