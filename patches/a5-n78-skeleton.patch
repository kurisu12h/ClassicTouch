+    g_autoptr(GError) gerr = NULL;
+    gsize size;
+    const uint8_t *trailer;
+    uint32_t load_pa, entry_pa, bootargs_pa, image_len;
+
+    cpu_reset(cs);
+    if (s->cpu_irq) {
+        /*
+         * The A6 kernel enables its decrementer (CNTV_CTL = 1: 0x80007fc8) before it first sets a deadline.
+         * CNTV_CVAL's reset value is UNKNOWN; start it as far off as it goes, so the first decrementer
+         * interrupt is one the kernel asked for.
+         */
+        s->cpu->env.cp15.c14_timer[GTIMER_VIRT].cval = UINT64_MAX;
+    }
+    gles_host_reset();
+    guest_pkg_reset(&s->pkg);
+
+    if (!g_file_get_contents(s->kboot_path, &data, &size, &gerr)) {
+        error_report("n78: cannot read kboot bundle '%s': %s",
+                     s->kboot_path, gerr->message);
+        exit(1);
+    }
+    if (size < KBOOT_TRAILER_LEN ||
+        memcmp(data + size - KBOOT_TRAILER_LEN, KBOOT_MAGIC, 8) != 0) {
+        error_report("n78: '%s' is not a K48KBOOT bundle", s->kboot_path);
+        exit(1);
+    }
+    trailer = (const uint8_t *)data + size - KBOOT_TRAILER_LEN;
+    load_pa = ldl_le_p(trailer + 8);
+    entry_pa = ldl_le_p(trailer + 12);
+    bootargs_pa = ldl_le_p(trailer + 16);
+    image_len = ldl_le_p(trailer + 20);
+
+    if (image_len > size - KBOOT_TRAILER_LEN ||
+        load_pa < S5L8940_DRAM_BASE ||
+        (uint64_t)load_pa + image_len > (uint64_t)S5L8940_DRAM_BASE + s->board->dram_size) {
+        error_report("n78: kboot bundle does not fit in DRAM "
+                     "(load 0x%x len 0x%x)", load_pa, image_len);
+        exit(1);
+    }
+    if (address_space_write(&address_space_memory, load_pa,
+                            MEMTXATTRS_UNSPECIFIED, data, image_len) != MEMTX_OK) {
+        error_report("n78: cannot stage kboot bundle at 0x%x", load_pa);
+        exit(1);
+    }
+    for (gsize off = image_len; off + KBOOT_SEGMENT_LEN <= size - KBOOT_TRAILER_LEN;) {
+        const uint8_t *seg = (const uint8_t *)data + off;
+        uint32_t pa = ldl_le_p(seg + 8), len = ldl_le_p(seg + 12);
+        bool zero = ldl_le_p(seg + 16) & 1;
+
+        off += KBOOT_SEGMENT_LEN + (zero ? 0 : len);
+        if (memcmp(seg, "K48SEG\0\0", 8) != 0 || off > size - KBOOT_TRAILER_LEN) {
+            error_report("n78: malformed segment in kboot bundle");
+            exit(1);
+        }
+        if (zero) {
+            address_space_set(&address_space_memory, pa, 0, len, MEMTXATTRS_UNSPECIFIED);
+        } else {
+            address_space_write(&address_space_memory, pa, MEMTXATTRS_UNSPECIFIED,
+                                seg + KBOOT_SEGMENT_LEN, len);
+        }
+    }
+
+    /* cpu_reset leaves us in SVC mode, IRQ/FIQ masked, MMU and caches off. */
+    s->cpu->env.regs[0] = bootargs_pa;
+    cpu_set_pc(cs, entry_pa);
+}
+
+/*
+ * The A6's decrementer. 10.3.4 registers no AIC timebase there, so mach_absolute_time reads CNTVCT and
+ * the decrementer is CNTV_TVAL (the fallbacks at 0x80007ff8 and 0x80008058). Without its interrupt no
+ * thread sleeping on a deadline wakes: the USB arbitrator stops after powering its PHY, a helper's sleep()
+ * never returns (docs/reports/a6-step1.md 7).
+ * Where it comes in: the vector page's 0x1C slot goes to fleh_decirq (0x80005b60), which saves the IRQ
+ * mode's lr and spsr as the interrupted state and only then re-enables FIQ (cpsie af); the AIC's IRQ
+ * handler panics on a timer event (kAICIackVecTypeTimer). So the timer is an IRQ, masked by CPSR.I and
+ * taken in IRQ mode, that vectors through 0x1C instead of 0x18: a decrementer exception of the core's own.
+ * Here it is a level on the core's IRQ line beside the AIC's, and taking an IRQ while it is up enters at
+ * 0x1C. rtclock_intr writes the next deadline (CNTV_TVAL), which drops it. The A5's FIQ (the AIC timer,
+ * fleh_fiq_generic) is left as it is; the A6 kernel never starts that timer.
+ */
+static void n41_irq_update(N78MachineState *s)
+{
+    qemu_set_irq(s->cpu_irq, qatomic_read(&s->aic_irq) || qatomic_read(&s->vtimer));
+}
+
+static void n41_aic_irq(void *opaque, int n, int level)
+{
+    N78MachineState *s = opaque;
+
+    qatomic_set(&s->aic_irq, level);
+    n41_irq_update(s);
+}
+
+static void n41_vtimer(void *opaque, int n, int level)
+{
+    N78MachineState *s = opaque;
+
+    qatomic_set(&s->vtimer, level);
+    n41_irq_update(s);
+}
+
+/*
+ * After the core has taken an exception (no BQL needed): an IRQ with the timer up enters at 0x1C, unless
+ * the AIC has one up too. That one goes first, to fleh_irq, and the timer's comes right after: a timer
+ * that fires again as soon as rtclock_intr returns would otherwise keep the AIC's waiting, and the IOP's
+ * completion with it ("IOP: timed out waiting for workloop to process completed command", a6-step1.md 13).
+ */
+static void n41_irq_taken(ARMCPU *cpu, void *opaque)
+{
+    N78MachineState *s = opaque;
+    CPUARMState *env = &cpu->env;
+
+    if (CPU(cpu)->exception_index == EXCP_IRQ && qatomic_read(&s->vtimer) && !qatomic_read(&s->aic_irq) &&
+        (env->regs[15] & 0x1f) == 0x18) {
+        env->regs[15] += 4;
+    }
+}
+
+static void n78_init(MachineState *machine)
+{
+    N78MachineState *s = N78_MACHINE(machine);
+    MemoryRegion *sysmem = get_system_memory();
+    Object *cpuobj;
+    DeviceState *dev;
+    SysBusDevice *sbd;
+
+    if (!s->kboot_path) {
+        error_report("n78: specify kboot=");
+        exit(1);
+    }
+
+    cpuobj = object_new(machine->cpu_type);
+    s->cpu = ARM_CPU(cpuobj);
+    object_property_set_link(cpuobj, "memory", OBJECT(sysmem), &error_abort);
+    object_property_set_bool(cpuobj, "has_el3", false, NULL);
+    object_property_set_bool(cpuobj, "has_el2", false, NULL);
+    if (object_property_find(cpuobj, "cntfrq")) {
+        /* Swift's generic timer: it counts the 24 MHz timebase the DT gives (timebase-frequency). */
+        object_property_set_uint(cpuobj, "cntfrq", 24000000, &error_abort);
+    }
+    object_property_set_bool(cpuobj, "realized", true, &error_fatal);
+    object_unref(cpuobj);
+    define_arm_cp_regs(s->cpu, n78_cp_reginfo);
+
+    memory_region_init_ram(&s->dram, NULL, "n78.dram", s->board->dram_size, &error_fatal);
+    memory_region_add_subregion(sysmem, S5L8940_DRAM_BASE, &s->dram);
+    /*
+     * PA 0: the SecureROM's window on the device. Early kernel init ml_io_maps PA 0 and copies the
+     * exception vectors there, which a ROM ignores. This was an alias of DRAM's first page (as kboot= on
+     * the A4, ipad1.c), and the copied vectors broke 9.3.5's USB: its EHCI periodic schedule has
+     * placeholder QHs whose next qTD pointer is 0 (T clear), so the controller reads a qTD at PA 0; the
+     * vectors there read as an active transfer and QEMU's EHCI reset itself on the error, dropping the
+     * port it had just enabled. A ROM-like page (a reset vector table, then zeros) reads as inactive.
+     */
+    memory_region_init_rom(&s->rom_lo, NULL, "n78.rom-lo", N78_ROM_LO_SIZE, &error_fatal);
+    {
+        uint32_t *rom = memory_region_get_ram_ptr(&s->rom_lo);
+
+        for (int i = 0; i < 8; i++) {
+            rom[i] = cpu_to_le32(0xe59ff018);       /* ldr pc, [pc, #0x18] */
+        }
+    }
+    memory_region_add_subregion(sysmem, 0, &s->rom_lo);
+
+    create_unimplemented_device("s5l8942.periph", S5L8940_IO_BASE, S5L8940_IO_SIZE);
+    /* GL writebacks only into memory a surface's process still maps there (docs/reports/a6-step1.md 13). */
+    gles_host_set_owner_check(true);
+
+    dev = qdev_new(TYPE_S5L8940_AIC);
+    s->aic = dev;
+    sbd = SYS_BUS_DEVICE(dev);
+    qdev_prop_set_uint32(dev, "num-cpus", 1);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, S5L8940_AIC_BASE);
+    if (arm_feature(&s->cpu->env, ARM_FEATURE_GENERIC_TIMER)) {
+        s->cpu_irq = qdev_get_gpio_in(DEVICE(s->cpu), ARM_CPU_IRQ);
+        sysbus_connect_irq(sbd, 0, qemu_allocate_irq(n41_aic_irq, s, 0));
+        qdev_connect_gpio_out(DEVICE(s->cpu), GTIMER_VIRT, qemu_allocate_irq(n41_vtimer, s, 0));
+        arm_register_el_change_hook(s->cpu, n41_irq_taken, s, false);
+    } else {
+        sysbus_connect_irq(sbd, 0, qdev_get_gpio_in(DEVICE(s->cpu), ARM_CPU_IRQ));
+    }
+    sysbus_connect_irq(sbd, 1, qdev_get_gpio_in(DEVICE(s->cpu), ARM_CPU_FIQ));
+
+    sysbus_create_simple(TYPE_S5L8940_PMGR, S5L8940_PMGR_BASE, NULL);
+
+    /*
+     * GPIO: the A5 kernel still matches AppleS5L8930XGPIOIC (DT
+     * "gpio,s5l8940x\0gpio,s5l8930x"), so the A4 model serves, sized to the
+     * DT's 28 ports and 8 interrupt groups. The I2C drivers read SDA and SCL
+     * off these pins (function-iic_sda/scl) before every transfer and call a
+     * low SDA a stuck bus, so both buses' pins rest high, as pulled up.
+     */
+    dev = qdev_new(TYPE_S5L8930_GPIO);
+    s->gpio = dev;
+    qdev_prop_set_uint32(dev, "ports", S5L8940_GPIO_PORTS);
+    qdev_prop_set_uint32(dev, "int-groups", S5L8940_GPIO_INT_GROUPS);
+    sbd = SYS_BUS_DEVICE(dev);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, S5L8940_GPIO_BASE);
+    sysbus_connect_irq(sbd, 0, qdev_get_gpio_in(s->aic, S5L8940_IRQ_GPIO));
+    for (int i = 0; i < s->board->n_i2c_pins; i++) {
+        s5l8930_gpio_set_rest_level(dev, S5L8930_GPIO_PIN(s->board->i2c_pins[i]), true);
+    }
+    for (int pin = 0; pin < s->board->buttons; pin++) {
+        s5l8930_gpio_set_rest_level(dev, S5L8930_GPIO_PIN(pin), true);     /* released */
+    }
+    qemu_input_handler_register(dev, &n78_kbd_handler);
+
+    /*
+     * spi1 and its multi-touch sensor, as the A4 machine has them (hw/arm/ipad1.c): the iPod's SPI and
+     * Zephyr2-protocol models, a TX FIFO deep enough for the firmware's one CDMA burst.
+     */
+    {
+        DeviceState *spi = qdev_new(TYPE_IPOD_TOUCH_SPI);
+
+        qdev_prop_set_uint8(spi, "index", 1);
+        qdev_prop_set_string(spi, "peripheral", "multitouch");
+        qdev_prop_set_uint32(spi, "tx-fifo-depth", 0x10000);
+        sysbus_realize_and_unref(SYS_BUS_DEVICE(spi), &error_fatal);
+        sysbus_mmio_map(SYS_BUS_DEVICE(spi), 0, S5L8940_SPI_BASE(1));
+        sysbus_connect_irq(SYS_BUS_DEVICE(spi), 0, qdev_get_gpio_in(s->aic, S5L8940_IRQ_SPI(1)));
+        s->mt = IPOD_TOUCH_SPI(spi)->mt;
+        s->mt->profile = s->board->mt;
+        qdev_connect_gpio_out_named(DEVICE(s->mt), "atn", 0,
+                                    qdev_get_gpio_in(dev, S5L8930_GPIO_PIN(s->board->mt_atn)));
+        qemu_add_mouse_event_handler(n78_mouse_event, s->mt, 1, "iPod touch 5G touchscreen");
+    }
+
+    /* i2c0 (the PMU) and i2c2 (and the A6's i2c1): sensors, nothing yet. Their AIC lines are 0x12 up. */
+    for (int n = 0; n <= 2; n++) {
+        g_autofree char *name = g_strdup_printf("i2c%d", n);
+
+        if (!(s->board->i2c_buses & (1 << n))) {
+            continue;
+        }
+        dev = qdev_new(TYPE_S5L8940_I2C);
+        s->i2c[n] = dev;
+        sbd = SYS_BUS_DEVICE(dev);
+        object_property_add_child(OBJECT(machine), name, OBJECT(dev));
+        sysbus_realize_and_unref(sbd, &error_fatal);
+        sysbus_mmio_map(sbd, 0, S5L8940_I2C_BASE(n));
+        sysbus_connect_irq(sbd, 0, qdev_get_gpio_in(s->aic, S5L8940_IRQ_I2C0 + n));
+    }
+    {
+        I2CSlave *pmu = i2c_slave_new(TYPE_S5L8940_D1881, S5L8940_D1881_ADDR);
+
+        if (s->board->pmu_adc_ctl) {
+            /* The D1972's ADC and its interrupt, on GPIO pmu_irq_pin (active low): s5l8940_i2c.c. */
+            qdev_prop_set_uint8(DEVICE(pmu), "adc-ctl", s->board->pmu_adc_ctl);
+            qdev_connect_gpio_out_named(DEVICE(pmu), "irq", 0,
+                                        qemu_irq_invert(qdev_get_gpio_in(s->gpio,
+                                                        S5L8930_GPIO_PIN(s->board->pmu_irq_pin))));
+        }
+        i2c_slave_realize_and_unref(pmu, I2C_BUS(qdev_get_child_bus(s->i2c[0], "i2c")), &error_fatal);
+    }
+    if (s->board->backlight_addr) {
+        /*
+         * The iPhone 5's LM3534: AppleLMBacklight::start reads its registers from 0x10 and, unanswered, logs
+         * "could not communicate with controller - tearing down driver". It only needs the read acknowledged,
+         * then writes a few settings back: the D1881 stand-in without its ADC is that register file (a6-step1.md
+         * 16.2). The panel's light itself stays the display model's.
+         */
+        I2CSlave *bl = i2c_slave_new(TYPE_S5L8940_D1881, s->board->backlight_addr);
+
+        i2c_slave_realize_and_unref(bl, I2C_BUS(qdev_get_child_bus(s->i2c[0], "i2c")), &error_fatal);
+    }
+
+    /*
+     * CDMA + AES: the A4 model. bsd_init cannot go on without it: IOSecureBSDRoot
+     * waits in AppleARMPE until IOAESAccelerator (AppleCDMA) has answered
+     * "SecureRootCallBack", which runs an AES job through channels 1 and 2.
+     * No I2S pacing yet (paced-ports 0): the A4's FIFO window is not the A5's.
+     */
+    dev = qdev_new(TYPE_S5L8930_CDMA);
+    qdev_prop_set_uint64(dev, "dram-base", S5L8940_DRAM_BASE);
+    qdev_prop_set_uint64(dev, "dram-size", s->board->dram_size);
+    qdev_prop_set_uint32(dev, "channels", S5L8940_CDMA_CHANNELS);
+    qdev_prop_set_uint8(dev, "version", 3);
+    qdev_prop_set_uint32(dev, "paced-ports", 0);
+    sbd = SYS_BUS_DEVICE(dev);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, S5L8940_CDMA_BASE);
+    sysbus_mmio_map(sbd, 1, S5L8940_AES_BASE);
+    for (int ch = 1; ch < S5L8940_CDMA_CHANNELS; ch++) {
+        sysbus_connect_irq(sbd, ch, qdev_get_gpio_in(s->aic, S5L8940_IRQ_CDMA(ch)));
+    }
+
+    /*
+     * Display: the A4's pipe/CLCD model, seeded as iBoot leaves a lit panel (CLCD +0x60 the panel size,
+     * ENVID on, UI0 on vram). Both kernels read only CLCD +0x60 before this and, finding 0, logged
+     * "CLCD not initied by iBoot, driver will not load". No DART in front of the pipe on the A5 (the DT's
+     * clcd has no mapper), so the model's dart2 stays unmapped and layer bases are physical.
+     */
+    dev = qdev_new(TYPE_S5L8930_DISPLAY);
+    qdev_prop_set_uint64(dev, "fb-base", N78_VRAM_BASE(s->board->dram_size));
+    qdev_prop_set_uint16(dev, "width", N78_FB_WIDTH);
+    qdev_prop_set_uint16(dev, "height", N78_FB_HEIGHT);
+    qdev_prop_set_bit(dev, "h4p", true);
+    qdev_prop_set_uint32(dev, "gamma-busy", s->board->clcd_gamma_busy);
+    sbd = SYS_BUS_DEVICE(dev);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, S5L8940_DISP_PIPE0_BASE);
+    sysbus_mmio_map(sbd, 1, S5L8940_CLCD_BASE);
+    sysbus_mmio_map(sbd, 3, S5L8940_RGBOUT_BASE);
+    sysbus_mmio_map(sbd, 4, S5L8940_TVOUT_BASE);
+    sysbus_mmio_map(sbd, 5, S5L8940_RGBOUT_CTRL_BASE);
+    sysbus_connect_irq(sbd, 0, qdev_get_gpio_in(s->aic, S5L8940_IRQ_DISP_PIPE0));
+    sysbus_connect_irq(sbd, 1, qdev_get_gpio_in(s->aic, S5L8940_IRQ_CLCD));
+    sysbus_connect_irq(sbd, 2, qdev_get_gpio_in(s->aic, S5L8940_IRQ_RGBOUT_PIPE));
+
+    /* MIPI-DSIM, the iPod's model; the link up as iBoot's pinot_init leaves it. */
+    dev = qdev_new(TYPE_IPOD_TOUCH_MIPI_DSI);
+    IPOD_TOUCH_MIPI_DSI(dev)->hs_clock_at_reset = true;
+    qdev_prop_set_uint32(dev, "lanes", 4);                   /* DT #lanes */
+    memory_region_add_subregion(get_system_memory(), S5L8940_DSIM_BASE,
+                                &IPOD_TOUCH_MIPI_DSI(dev)->iomem);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+
+    /*
+     * USB, as the A4 machine has it (hw/arm/ipad1.c): the iPod's PHY and Synopsys OTG models for
+     * device mode, with the OTG's built-in host when no usbmux bridge is dialed (usb-tcp, IT_USB_TCP);
+     * QEMU's EHCI (capabilities at +0) and OHCI for the host nubs, which kboot's usb-complex
+     * hsic-enabled has the arbitrator publish at start. Without the EHCI both kernels panic on the
+     * way to reboot: StopUSBBus waits 100 ms for USBSTS.HCHalted. Attach with -device usb-storage,bus=ehci.0.
+     */
+    dev = qdev_new(TYPE_IPOD_TOUCH_USB_PHYS);
+    sbd = SYS_BUS_DEVICE(dev);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, S5L8940_USB_PHY_BASE);
+
+    dev = ipod_touch_init_usb_otg(qdev_get_gpio_in(s->aic, S5L8940_IRQ_USB_OTG), n78_usb_hwcfg);
+    S5L8900USBOTG(dev)->builtin_host = !getenv("IT_USB_TCP");
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    memory_region_add_subregion(get_system_memory(), S5L8940_USB_OTG_BASE, &S5L8900USBOTG(dev)->iomem);
+
+    dev = qdev_new(TYPE_EXYNOS4210_EHCI);
+    dev->id = g_strdup("ehci");                     /* its bus: ehci.0 */
+    sbd = SYS_BUS_DEVICE(dev);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, S5L8940_USB_EHCI_BASE);
+    sysbus_connect_irq(sbd, 0, qdev_get_gpio_in(s->aic, S5L8940_IRQ_USB_EHCI));
+
+    dev = qdev_new(TYPE_SYSBUS_OHCI);
+    dev->id = g_strdup("ohci");                     /* its bus: ohci.0 */
+    qdev_prop_set_uint32(dev, "num-ports", 1);      /* DT port-count */
+    sbd = SYS_BUS_DEVICE(dev);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, S5L8940_USB_OHCI0_BASE);
+    sysbus_connect_irq(sbd, 0, qdev_get_gpio_in(s->aic, S5L8940_IRQ_USB_OHCI0));
+
+    /* IOP: the AP's side of it, for AppleIOPFMI's NAND (hw/arm/s5l8940_iop.c). */
+    dev = qdev_new(TYPE_S5L8940_IOP);
+    object_property_set_link(OBJECT(dev), "aic", OBJECT(s->aic), &error_fatal);
+    sbd = SYS_BUS_DEVICE(dev);
+    sysbus_realize_and_unref(sbd, &error_fatal);
+    sysbus_mmio_map(sbd, 0, S5L8940_IOP_BASE);
+
+    /* Console: serial0 on the board's console UART. Its AIC line is wired once the DT gives it. */
+    exynos4210_uart_create(S5L8940_UART_BASE(s->board->console_uart), 256, s->board->console_uart,
+                           serial_hd(0), NULL, false);
+
+    /*
+     * The iPhone 5's gas gauge (uart5/gas-gauge, bq27540 over HDQ): the A4 machine's model (s5l8930_hdq.c, a
+     * 16-byte FIFO as ipad1.c explains), full and on battery. Unanswered, the battery icon showed nearly empty.
+     */
+    if (s->board->gauge_mah) {
+        Chardev *gauge = qemu_chardev_new(NULL, TYPE_CHARDEV_S5L8930_HDQ, NULL, NULL, &error_abort);
+
+        s5l8930_hdq_set_capacity(gauge, s->board->gauge_mah);
+        s5l8930_hdq_set_battery(gauge, 100, false);
+        exynos4210_uart_create(S5L8940_UART_BASE(5), 16, 5, gauge,
+                               qdev_get_gpio_in(s->aic, S5L8940_IRQ_UART(5)), true);
+    }
+
+    qemu_register_reset(n78_cpu_reset, s);
+}
+
+static char *n78_get_kboot(Object *obj, Error **errp)
+{
+    return g_strdup(N78_MACHINE(obj)->kboot_path);
+}
+
+static void n78_set_kboot(Object *obj, const char *value, Error **errp)
+{
+    N78MachineState *s = N78_MACHINE(obj);
+
+    g_free(s->kboot_path);
+    s->kboot_path = g_strdup(value);
+}
+
+static void n78_class_init(ObjectClass *klass, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(klass);
+
+    N78_MACHINE_CLASS(klass)->board = &board_n78;
+    mc->desc = "iPod touch 5G (N78AP, S5L8942X)";
+    mc->init = n78_init;
+    mc->max_cpus = 1;
+    mc->default_cpu_type = ARM_CPU_TYPE_NAME("cortex-a9");
+    mc->default_ram_size = board_n78.dram_size;
+    object_class_property_add_str(klass, "kboot", n78_get_kboot, n78_set_kboot);
+    gles_host_class_init(klass);
+    object_class_property_set_description(klass, "kboot",
+                                          "K48KBOOT bundle from tools/a5/n78_kboot.py (board n78 or n41)");
+}
+
+/* The iPhone 5: the iPod touch 5 with Swift cores and n41's board. */
+static void n41_class_init(ObjectClass *klass, const void *data)
+{
+    MachineClass *mc = MACHINE_CLASS(klass);
+
+    N78_MACHINE_CLASS(klass)->board = &board_n41;
+    mc->desc = "iPhone 5 (N41AP, S5L8950X)";
+    mc->default_cpu_type = ARM_CPU_TYPE_NAME("apple-swift");
+    mc->default_ram_size = board_n41.dram_size;
+}
+
+static void n78_instance_init(Object *obj)
+{
+    N78_MACHINE(obj)->board = N78_MACHINE_GET_CLASS(obj)->board;
+    guest_pkg_init(&N78_MACHINE(obj)->pkg, obj);
+}
+
+static const TypeInfo n78_machine_info = {
+    .name = TYPE_N78_MACHINE,
+    .parent = TYPE_MACHINE,
+    .instance_init = n78_instance_init,
+    .interfaces = arm_machine_interfaces,
+    .instance_size = sizeof(N78MachineState),
+    .class_size = sizeof(N78MachineClass),
+    .class_init = n78_class_init,
+};
+
+static const TypeInfo n41_machine_info = {
+    .name = TYPE_N41_MACHINE,
+    .parent = TYPE_N78_MACHINE,
+    .class_init = n41_class_init,
+};
+
+static void n78_machine_types(void)
+{
+    type_register_static(&n78_machine_info);
+    type_register_static(&n41_machine_info);
+}
+
+type_init(n78_machine_types)
