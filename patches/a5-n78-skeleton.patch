+void ipod_touch_5g_press_button(IPodTouchButton button, bool down)
+{
+    static const int pins[] = {
+        [IPOD_TOUCH_BUTTON_HOME] = N78_GPIO_BTN_MENU,
+        [IPOD_TOUCH_BUTTON_POWER] = N78_GPIO_BTN_HOLD,
+        [IPOD_TOUCH_BUTTON_VOLUP] = N78_GPIO_BTN_VOLUP,
+        [IPOD_TOUCH_BUTTON_VOLDOWN] = N78_GPIO_BTN_VOLDN,
+    };
+    N78MachineState *s = (N78MachineState *)
+        object_dynamic_cast(OBJECT(qdev_get_machine()), TYPE_N78_MACHINE);
