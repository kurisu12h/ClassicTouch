@@ -395,6 +395,11 @@ static inline const char *gles_id_name(uint32_t id)
 #define GLES_SURFACE_LA88               0x32433038  /* '2C08' */
 /* The same two channels as 7.x QuartzCore names them on its IOSurfaces (text and glyph layers). */
 #define GLES_SURFACE_LA88_IOS7          0x4c413838  /* 'LA88' */
+/* And as 10.x QuartzCore names them (10.3.4's home screen icon labels and Dock titles). */
+#define GLES_SURFACE_LA88_IOS10         0x4c413038  /* 'LA08' */
+/* Four half floats, R G B A, little-endian (10.x QuartzCore's 256x1 filter lookup tables). Sampled as
+ * 8-bit RGBA, clamped to [0, 1]. */
+#define GLES_SURFACE_RGBA_HALF          0x52476841  /* 'RGhA' */
 /* 16 bits, A1R5G5B5 little-endian (premultiplied: a clear pixel is 0), in rows: 3.1.3's album
  * covers (ArtworkCache's 320x320, 16-bit skip-first data) as CoreAnimation hands them over. */
 #define GLES_SURFACE_ARGB1555           0x35353531  /* '5551' */
@@ -429,6 +434,9 @@ char *gles_host_rejects(void);
  * the viewport magenta, so a screenshot shows the gap; off, the least-bad fallback stays. */
 void gles_host_set_debug(bool on);
 bool gles_host_debug(void);
+/* Check a surface's kept pages against its process's page tables before each writeback (gles-host.c
+ * gles_surface_owned). The A5/A6 machines turn it on; 4.x unmaps surface pages a process still owns. */
+void gles_host_set_owner_check(bool on);
 /* The newest write generation the bridge recorded on RAM [addr, addr + len): it clears QEMU's
  * VGA dirty bits of every surface page it checks (its own write-backs included), so a display
  * model that scans such pages out through the dirty log compares this too, or misses frames. */
