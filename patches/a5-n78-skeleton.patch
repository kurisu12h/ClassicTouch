diff --git a/hw/arm/s5l8940_aic.c b/hw/arm/s5l8940_aic.c
new file mode 100644
index 0000000000..11f76654be
--- /dev/null
+++ b/hw/arm/s5l8940_aic.c
@@ -0,0 +1,570 @@
+/*
+ * Apple Interrupt Controller as the 32-bit A5 has it (DT "aic,1",
+ * AppleInterruptController), replacing the A4's four PL192s.
+ *
+ * Register map: xnu-4570.1.46 pexpert/pexpert/arm/AIC.h, the first open
+ * xnu with 32-bit ARM. How the kernel drives the per-core timer comes from
+ * the same release's T8002 path (pe_identify_machine.c pe_arm_init_timer,
+ * machine_routines_asm.s fleh_fiq_t8002 / t8002_{get,set}_decrementer):
+ *   - the decrementer is kAICTmrCnt: written with a tick count, read back
+ *     as what is left;
+ *   - it fires on FIQ, and the FIQ handler clears it by writing
+ *     kAICTmrIntStatPct to kAICTmrIntStat.
+ * External interrupts come on IRQ and are taken by reading kAICIack, which
+ * masks the line it returns until the driver writes kAICIntMaskClr (as on
+ * the later AICs; an assumption still). IPIs work the same way with their
+ * own mask, per core at +0x24 (set) and +0x28 (clear), bit 31 the self IPI
+ * and bit 0 the normal one: 9.3.5's AppleInterruptController writes those in
+ * disableVectorHard/enableVector for an IPI vector, and both kernels mask
+ * both IPIs at boot (0x2024 = 0x80000001). Taking an IPI through kAICIack
+ * masks it and leaves it pending until kAICIPIClr (see aic_core_read).
+ *
+ * The banked registers at 0x2000 answer for the CPU doing the access; the
+ * aliases at 0x5000 + 0x80 * n for CPU n.
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "qemu/timer.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/core/cpu.h"
+#include "hw/arm/s5l8940.h"
+
+#define AIC_REV             0x0000
+#define AIC_CAP0            0x0004
+#define AIC_CAP1            0x0008
+#define AIC_RST             0x000c
+#define AIC_GLBCFG          0x0010
+#define AIC_MAIN_TIM_LO     0x0020
+#define AIC_MAIN_TIM_HI     0x0028
+#define AIC_IPI_NORMAL_DBG  0x0030
+#define AIC_IPI_SELF_DBG    0x0034
+
+#define AIC_BANKED          0x2000          /* this CPU's view */
+#define AIC_BANKED_END      0x202c
+#define AIC_ALIAS           0x5000          /* CPU n's view at +0x80 * n */
+#define AIC_ALIAS_STRIDE    0x80
+
+/* Offsets inside a banked or alias block. */
+#define CORE_WHOAMI         0x00
+#define CORE_IACK           0x04
+#define CORE_IPI_SET        0x08
+#define CORE_IPI_CLR        0x0c
+#define CORE_TMR_CFG        0x10
+#define CORE_TMR_CNT        0x14
+#define CORE_TMR_INTSTAT    0x18
+#define CORE_TMR_STATE_SET  0x1c
+#define CORE_TMR_STATE_CLR  0x20
+#define CORE_IPI_MASK_SET   0x24
+#define CORE_IPI_MASK_CLR   0x28
+
+#define IPI_CLR_SELF        0x80000000u
+#define IPI_MASK_SELF       0x80000000u
+#define IPI_MASK_NORMAL     1u
+#define TMR_CFG_EN          1u
+#define TMR_INTSTAT_PCT     1u
+
+#define IACK_SPURIOUS       0
+#define IACK_EXT(n)         ((1u << 16) | ((n) & 0x3ff))
+#define IACK_IPI_NORMAL     ((4u << 16) | 1)
+#define IACK_IPI_SELF       ((4u << 16) | 2)
+
+#define AIC_TGT_DST(n)      (0x3000 + 4 * (n))
+#define AIC_SW_SET(n)       (0x4000 + 4 * (n))
+#define AIC_SW_CLR(n)       (0x4080 + 4 * (n))
+#define AIC_MASK_SET(n)     (0x4100 + 4 * (n))
+#define AIC_MASK_CLR(n)     (0x4180 + 4 * (n))
+#define AIC_HW_MON(n)       (0x4200 + 4 * (n))
+
+#define AIC_WORDS           (S5L8940_AIC_NR_IRQS / 32)
+
+typedef struct AICCore {
+    struct S5L8940AICState *aic;
+    bool ipi_normal, ipi_self;
+    uint32_t ipi_mask;                       /* IPI_MASK_SELF | IPI_MASK_NORMAL */
+    uint32_t tmr_cfg, tmr_intstat, tmr_state;
+    int64_t tmr_deadline_ns;                 /* when the decrementer reaches 0 */
+    QEMUTimer *timer;
+    qemu_irq irq, fiq;
+} AICCore;
+
+struct S5L8940AICState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    uint32_t num_cpus;
+    uint32_t timebase_hz;
+
+    uint32_t glbcfg, rst;
+    int64_t main_tim_offset;                 /* ticks added to the free-running count */
+    uint32_t main_tim_hi_latch;
+    uint32_t hw[AIC_WORDS], sw[AIC_WORDS], mask[AIC_WORDS];
+    uint32_t target[S5L8940_AIC_NR_IRQS];
+    AICCore core[S5L8940_AIC_MAX_CPUS];
+    void (*ipid_fn)(void *opaque, int vector);  /* s5l8940_aic_set_ipid_handler */
+    void *ipid_opaque;
+};
+
+static uint64_t aic_ticks(S5L8940AICState *s, int64_t ns)
+{
+    return muldiv64(ns, s->timebase_hz, NANOSECONDS_PER_SECOND);
+}
+
+static int64_t aic_ns(S5L8940AICState *s, uint64_t ticks)
+{
+    return muldiv64(ticks, NANOSECONDS_PER_SECOND, s->timebase_hz);
+}
+
+static bool aic_ext_pending_for(S5L8940AICState *s, int cpu, int *irq_out)
+{
+    for (int w = 0; w < AIC_WORDS; w++) {
+        uint32_t p = (s->hw[w] | s->sw[w]) & ~s->mask[w];
+
+        while (p) {
+            int n = w * 32 + ctz32(p);
+
+            p &= p - 1;
+            /*
+             * A line nobody has targeted goes to CPU 0, so a driver that unmasks
+             * before writing TgtDst still sees its interrupt during bring-up.
+             */
+            if ((s->target[n] ? s->target[n] : 1) & (1u << cpu)) {
+                if (irq_out) {
+                    *irq_out = n;
+                }
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+static bool aic_ipi_self_live(AICCore *core)
+{
+    return core->ipi_self && !(core->ipi_mask & IPI_MASK_SELF);
+}
+
+static bool aic_ipi_normal_live(AICCore *core)
+{
+    return core->ipi_normal && !(core->ipi_mask & IPI_MASK_NORMAL);
+}
+
+static void aic_update(S5L8940AICState *s)
+{
+    for (int c = 0; c < s->num_cpus; c++) {
+        AICCore *core = &s->core[c];
+
+        qemu_set_irq(core->irq, aic_ipi_self_live(core) || aic_ipi_normal_live(core) ||
+                                aic_ext_pending_for(s, c, NULL));
+        qemu_set_irq(core->fiq, (core->tmr_cfg & TMR_CFG_EN) &&
+                                (core->tmr_intstat & TMR_INTSTAT_PCT));
+    }
+}
+
+static void aic_timer_cb(void *opaque)
+{
+    AICCore *core = opaque;
+
+    core->tmr_intstat |= TMR_INTSTAT_PCT;
+    aic_update(core->aic);
+}
+
+static uint32_t aic_tmr_cnt(S5L8940AICState *s, AICCore *core)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (core->tmr_deadline_ns <= now) {
+        return 0;
+    }
+    return MIN(aic_ticks(s, core->tmr_deadline_ns - now), 0xffffffffull);
+}
+
+static void aic_tmr_set_cnt(S5L8940AICState *s, AICCore *core, uint32_t cnt)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    core->tmr_deadline_ns = now + aic_ns(s, cnt);
+    timer_mod(core->timer, core->tmr_deadline_ns);
+}
+
+static int aic_current_cpu(S5L8940AICState *s)
+{
+    int c = current_cpu ? current_cpu->cpu_index : 0;
+
+    return c < s->num_cpus ? c : 0;
+}
+
+static uint32_t aic_core_read(S5L8940AICState *s, int c, hwaddr off)
+{
+    AICCore *core = &s->core[c];
+    int n;
+
+    switch (off) {
+    case CORE_WHOAMI:
+        return c;
+    case CORE_IACK:
+        /*
+         * Taking an IPI through Iack masks it; it stays pending until IPIClr.
+         * The handler skips an IPI whose vector is not registered yet, with no
+         * IPIClr: 7.1.2 after the performance controller starts, and 9.3.5 when
+         * AppleARMCPU kicks cpu0 (causeVector 0xc0) before its vector is in.
+         * That IPI must come back once enableVector unmasks it (+0x28): it is
+         * what clears the kernel's SIGPdisabled and runs a SIGPdec that a timer
+         * FIQ left while IRQs were off (9.3.5 fleh_dec -> cpu_signal). Cleared
+         * on Iack, it was lost, and 9.3.5's decrementer never rearmed.
+         */
+        if (aic_ipi_self_live(core)) {
+            core->ipi_mask |= IPI_MASK_SELF;
+            aic_update(s);
+            return IACK_IPI_SELF;
+        }
+        if (aic_ipi_normal_live(core)) {
+            core->ipi_mask |= IPI_MASK_NORMAL;
+            aic_update(s);
+            return IACK_IPI_NORMAL;
+        }
+        if (aic_ext_pending_for(s, c, &n)) {
+            s->mask[n / 32] |= 1u << (n % 32);
+            aic_update(s);
+            return IACK_EXT(n);
+        }
+        return IACK_SPURIOUS;
+    case CORE_TMR_CFG:
+        return core->tmr_cfg;
+    case CORE_TMR_CNT:
+        return aic_tmr_cnt(s, core);
+    case CORE_TMR_INTSTAT:
+        return core->tmr_intstat;
+    case CORE_TMR_STATE_SET:
+    case CORE_TMR_STATE_CLR:
+        return core->tmr_state;
+    case CORE_IPI_MASK_SET:
+    case CORE_IPI_MASK_CLR:
+        return core->ipi_mask;
+    default:
+        qemu_log_mask(LOG_UNIMP, "aic: cpu%d read of core reg 0x%" HWADDR_PRIx "\n", c, off);
+        return 0;
+    }
+}
+
+static void aic_core_write(S5L8940AICState *s, int c, hwaddr off, uint32_t val)
+{
+    AICCore *core = &s->core[c];
+
+    switch (off) {
+    case CORE_IPI_SET:
+        if (val & IPI_CLR_SELF) {
+            core->ipi_self = true;
+        }
+        for (int t = 0; t < s->num_cpus; t++) {
+            if (val & (1u << t)) {
+                s->core[t].ipi_normal = true;
+            }
+        }
+        break;
+    case CORE_IPI_CLR:
+        if (val & IPI_CLR_SELF) {
+            core->ipi_self = false;
+        }
+        if (val & ~IPI_CLR_SELF) {
+            core->ipi_normal = false;
+        }
+        break;
+    case CORE_TMR_CFG:
+        core->tmr_cfg = val;
+        break;
+    case CORE_TMR_CNT:
+        aic_tmr_set_cnt(s, core, val);
+        break;
+    case CORE_TMR_INTSTAT:
+        core->tmr_intstat &= ~val;
+        break;
+    case CORE_TMR_STATE_SET:
+        core->tmr_state |= val;
+        break;
+    case CORE_TMR_STATE_CLR:
+        core->tmr_state &= ~val;
+        break;
+    case CORE_IPI_MASK_SET:
+        core->ipi_mask |= val & (IPI_MASK_SELF | IPI_MASK_NORMAL);
+        break;
+    case CORE_IPI_MASK_CLR:
+        core->ipi_mask &= ~val;
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "aic: cpu%d write 0x%x to core reg 0x%" HWADDR_PRIx "\n",
+                      c, val, off);
+        return;
+    }
+    aic_update(s);
+}
+
+static uint64_t aic_main_tim(S5L8940AICState *s)
+{
+    return aic_ticks(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL)) + s->main_tim_offset;
+}
+
+/* AIC_TRACE=1: log every register access, for bring-up. */
+static bool aic_trace(void)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        on = g_strcmp0(getenv("AIC_TRACE"), "1") == 0;
+    }
+    return on;
+}
+
+static uint64_t aic_read_reg(void *opaque, hwaddr addr, unsigned size);
+
+static uint64_t aic_read(void *opaque, hwaddr addr, unsigned size)
+{
+    uint64_t val = aic_read_reg(opaque, addr, size);
+
+    if (aic_trace()) {
+        qemu_log("aic: read  0x%04" HWADDR_PRIx " -> 0x%08" PRIx64 "\n", addr, val);
+    }
+    return val;
+}
+
+static uint64_t aic_read_reg(void *opaque, hwaddr addr, unsigned size)
+{
+    S5L8940AICState *s = opaque;
+
+    if (addr >= AIC_BANKED && addr < AIC_BANKED_END) {
+        return aic_core_read(s, aic_current_cpu(s), addr - AIC_BANKED);
+    }
+    if (addr >= AIC_ALIAS && addr < AIC_ALIAS + AIC_ALIAS_STRIDE * s->num_cpus) {
+        return aic_core_read(s, (addr - AIC_ALIAS) / AIC_ALIAS_STRIDE,
+                             (addr - AIC_ALIAS) % AIC_ALIAS_STRIDE);
+    }
+    if (addr >= AIC_TGT_DST(0) && addr < AIC_TGT_DST(S5L8940_AIC_NR_IRQS)) {
+        return s->target[(addr - AIC_TGT_DST(0)) / 4];
+    }
+    /* The set and clear halves both read back the current word. */
+    if (addr >= AIC_SW_SET(0) && addr < AIC_SW_SET(AIC_WORDS)) {
+        return s->sw[(addr - AIC_SW_SET(0)) / 4];
+    }
+    if (addr >= AIC_SW_CLR(0) && addr < AIC_SW_CLR(AIC_WORDS)) {
+        return s->sw[(addr - AIC_SW_CLR(0)) / 4];
+    }
+    if (addr >= AIC_MASK_SET(0) && addr < AIC_MASK_SET(AIC_WORDS)) {
+        return s->mask[(addr - AIC_MASK_SET(0)) / 4];
+    }
+    if (addr >= AIC_MASK_CLR(0) && addr < AIC_MASK_CLR(AIC_WORDS)) {
+        return s->mask[(addr - AIC_MASK_CLR(0)) / 4];
+    }
+    if (addr >= AIC_HW_MON(0) && addr < AIC_HW_MON(AIC_WORDS)) {
+        return s->hw[(addr - AIC_HW_MON(0)) / 4];
+    }
+
+    switch (addr) {
+    case AIC_REV:
+        return 0;
+    case AIC_CAP0:
+        return ((s->num_cpus - 1) << 16) | S5L8940_AIC_NR_IRQS;
+    case AIC_CAP1:
+        return 0;
+    case AIC_RST:
+        return s->rst;
+    case AIC_GLBCFG:
+        return s->glbcfg;
+    case AIC_MAIN_TIM_LO: {
+        uint64_t t = aic_main_tim(s);
+
+        s->main_tim_hi_latch = t >> 32;
+        return (uint32_t)t;
+    }
+    case AIC_MAIN_TIM_HI:
+        return s->main_tim_hi_latch;
+    default:
+        qemu_log_mask(LOG_UNIMP, "aic: read of 0x%" HWADDR_PRIx "\n", addr);
+        return 0;
+    }
+}
+
+static void aic_write(void *opaque, hwaddr addr, uint64_t val64, unsigned size)
+{
+    S5L8940AICState *s = opaque;
+    uint32_t val = val64;
+    int w;
+
+    if (aic_trace()) {
+        qemu_log("aic: write 0x%04" HWADDR_PRIx " <- 0x%08x\n", addr, val);
+    }
+    if (addr >= AIC_BANKED && addr < AIC_BANKED_END) {
+        aic_core_write(s, aic_current_cpu(s), addr - AIC_BANKED, val);
+        return;
+    }
+    if (addr >= AIC_ALIAS && addr < AIC_ALIAS + AIC_ALIAS_STRIDE * s->num_cpus) {
+        aic_core_write(s, (addr - AIC_ALIAS) / AIC_ALIAS_STRIDE,
+                       (addr - AIC_ALIAS) % AIC_ALIAS_STRIDE, val);
+        return;
+    }
+    if (addr >= AIC_TGT_DST(0) && addr < AIC_TGT_DST(S5L8940_AIC_NR_IRQS)) {
+        s->target[(addr - AIC_TGT_DST(0)) / 4] = val;
+        aic_update(s);
+        return;
+    }
+    if (addr >= AIC_SW_SET(0) && addr < AIC_SW_SET(AIC_WORDS)) {
+        w = (addr - AIC_SW_SET(0)) / 4;
+        s->sw[w] |= val;
+        /* An IPID vector set by the AP may be a coprocessor's doorbell: its handler decides. */
+        if (w == 0 && s->ipid_fn) {
+            for (int n = 0; n < S5L8940_AIC_IPID_VECTORS; n++) {
+                if (val & (1u << n)) {
+                    s->ipid_fn(s->ipid_opaque, n);
+                }
+            }
+        }
+    } else if (addr >= AIC_SW_CLR(0) && addr < AIC_SW_CLR(AIC_WORDS)) {
+        s->sw[(addr - AIC_SW_CLR(0)) / 4] &= ~val;
+    } else if (addr >= AIC_MASK_SET(0) && addr < AIC_MASK_SET(AIC_WORDS)) {
+        s->mask[(addr - AIC_MASK_SET(0)) / 4] |= val;
+    } else if (addr >= AIC_MASK_CLR(0) && addr < AIC_MASK_CLR(AIC_WORDS)) {
+        s->mask[(addr - AIC_MASK_CLR(0)) / 4] &= ~val;
+    } else {
+        switch (addr) {
+        case AIC_RST:
+            s->rst = val;
+            break;
+        case AIC_GLBCFG:
+            s->glbcfg = val;
+            break;
+        case AIC_MAIN_TIM_LO:
+        case AIC_MAIN_TIM_HI: {
+            uint64_t t = aic_main_tim(s);
+
+            w = addr == AIC_MAIN_TIM_HI;
+            t = w ? (t & 0xffffffffull) | ((uint64_t)val << 32)
+                  : (t & ~0xffffffffull) | val;
+            s->main_tim_offset = t - aic_ticks(s, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL));
+            break;
+        }
+        default:
+            qemu_log_mask(LOG_UNIMP, "aic: write 0x%x to 0x%" HWADDR_PRIx "\n", val, addr);
+            return;
+        }
+    }
+    aic_update(s);
+}
+
+static const MemoryRegionOps aic_ops = {
+    .read = aic_read,
+    .write = aic_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+void s5l8940_aic_set_ipid_handler(DeviceState *dev, void (*fn)(void *opaque, int vector),
+                                  void *opaque)
+{
+    S5L8940AICState *s = S5L8940_AIC(dev);
+
+    s->ipid_fn = fn;
+    s->ipid_opaque = opaque;
+}
+
+/* A coprocessor raising (or taking back) an IPID vector, as its kAICSWGenSet/Clr writes would. */
+void s5l8940_aic_sw_set(DeviceState *dev, int vector, bool on)
+{
+    S5L8940AICState *s = S5L8940_AIC(dev);
+
+    if (on) {
+        s->sw[vector / 32] |= 1u << (vector % 32);
+    } else {
+        s->sw[vector / 32] &= ~(1u << (vector % 32));
+    }
+    aic_update(s);
+}
+
+/* Input lines, level-triggered, as the SoC's blocks raise them. */
+static void aic_set_irq(void *opaque, int n, int level)
+{
+    S5L8940AICState *s = opaque;
+
+    if (level) {
+        s->hw[n / 32] |= 1u << (n % 32);
+    } else {
+        s->hw[n / 32] &= ~(1u << (n % 32));
+    }
+    aic_update(s);
+}
+
+static void aic_reset_hold(Object *obj, ResetType type)
+{
+    S5L8940AICState *s = S5L8940_AIC(obj);
+
+    s->glbcfg = 0;
+    s->rst = 0;
+    s->main_tim_offset = 0;
+    memset(s->sw, 0, sizeof(s->sw));
+    memset(s->mask, 0xff, sizeof(s->mask));  /* every line masked out of reset */
+    memset(s->target, 0, sizeof(s->target));
+    for (int c = 0; c < S5L8940_AIC_MAX_CPUS; c++) {
+        AICCore *core = &s->core[c];
+
+        core->ipi_normal = core->ipi_self = false;
+        core->ipi_mask = 0;
+        core->tmr_cfg = core->tmr_intstat = core->tmr_state = 0;
+        core->tmr_deadline_ns = 0;
+        if (core->timer) {
+            timer_del(core->timer);
+        }
+    }
+    aic_update(s);
+}
+
+static void aic_realize(DeviceState *dev, Error **errp)
+{
+    S5L8940AICState *s = S5L8940_AIC(dev);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(dev);
+
+    if (s->num_cpus < 1 || s->num_cpus > S5L8940_AIC_MAX_CPUS) {
+        error_setg(errp, "aic: num-cpus must be 1 to %d", S5L8940_AIC_MAX_CPUS);
+        return;
+    }
+    memory_region_init_io(&s->iomem, OBJECT(s), &aic_ops, s, "s5l8940.aic",
+                          S5L8940_AIC_SIZE);
+    sysbus_init_mmio(sbd, &s->iomem);
+    /* Outputs: IRQ then FIQ for each CPU. */
+    for (int c = 0; c < s->num_cpus; c++) {
+        s->core[c].aic = s;
+        s->core[c].timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, aic_timer_cb, &s->core[c]);
+        sysbus_init_irq(sbd, &s->core[c].irq);
+        sysbus_init_irq(sbd, &s->core[c].fiq);
+    }
+    qdev_init_gpio_in(dev, aic_set_irq, S5L8940_AIC_NR_IRQS);
+}
+
+static const Property aic_properties[] = {
+    DEFINE_PROP_UINT32("num-cpus", S5L8940AICState, num_cpus, 1),
+    DEFINE_PROP_UINT32("timebase-hz", S5L8940AICState, timebase_hz, 24000000),
+};
+
+static void aic_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->realize = aic_realize;
+    rc->phases.hold = aic_reset_hold;
+    device_class_set_props(dc, aic_properties);
+}
+
+static const TypeInfo aic_info = {
+    .name = TYPE_S5L8940_AIC,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(S5L8940AICState),
+    .class_init = aic_class_init,
+};
+
+static void aic_register_types(void)
+{
+    type_register_static(&aic_info);
+}
+
+type_init(aic_register_types)
diff --git a/hw/arm/s5l8940_i2c.c b/hw/arm/s5l8940_i2c.c
new file mode 100644
index 0000000000..9a04a42f67
--- /dev/null
+++ b/hw/arm/s5l8940_i2c.c
@@ -0,0 +1,410 @@
+/*
+ * S5L8940 ("A5") I2C controller (DT "i2c,s5l8940x", AppleS5L8940XI2CController)
+ * and a register-file stand-in for the Dialog D1881 PMU on i2c0.
+ *
+ * Unlike the A4's Samsung-style controller (s5l8930_i2c.c) this is the PA Semi
+ * SMBus block Linux drives as i2c-pasemi, read off 7.1.2's driver
+ * (__PRELINK_TEXT 0x80976c40 init, 0x80976e80 transfer, 0x809776f8 RX drain,
+ * 0x80977034 _checkBusStatus):
+ *   0x00 MTXFIFO  command words: data byte | 0x100 START | 0x200 STOP | 0x400
+ *                 READ (the byte is then the count). A write is START+addr,
+ *                 the bytes, STOP on the last; a read is START+(addr|1), then
+ *                 count|READ|STOP.
+ *   0x04 MRXFIFO  a received byte, or 0x100 while empty (the driver spins on it)
+ *   0x14 SMSTA    status, write-1-to-clear; XIP bit 28 while a transfer runs,
+ *                 XEN bit 27 when it ended. Init clears 0x0aa00040.
+ *   0x18 IMASK    which SMSTA bits interrupt
+ *   0x1c CTL      bits 0-7 the clock divider (init writes max(4, DT value))
+ *   0x0c XFSTA    "xfer" in the driver's failure log (i2c-pasemi's name)
+ *   0x08, 0x10, 0x20-0x3c  0x08 is the log's "fifo", 0x10 written 0x80000000
+ *                 at init, 0x2c 0x100 before an interrupt-mode wait. Kept, not
+ *                 decoded.
+ * A transfer runs to completion inside the MTXFIFO write.
+ *
+ * Whether SDA is stuck is read off the pin (function-iic_sda, a GPIO), not this
+ * block: the machine rests those pins high.
+ *
+ * I2C_TRACE=1 logs every controller access and every PMU register access.
+ */
+#include "qemu/osdep.h"
+#include "qapi/error.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/core/irq.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/i2c/i2c.h"
+#include "hw/arm/s5l8940.h"
+
+#define I2C_MTXFIFO     0x00
+#define I2C_MRXFIFO     0x04
+#define I2C_REG08       0x08
+#define I2C_REG0C       0x0c
+#define I2C_REG10       0x10
+#define I2C_SMSTA       0x14
+#define I2C_IMASK       0x18
+#define I2C_CTL         0x1c
+
+#define MTX_START       0x100
+#define MTX_STOP        0x200
+#define MTX_READ        0x400
+#define MRX_EMPTY       0x100
+
+/* Bit names as Linux i2c-pasemi-core.c has them. */
+#define SMSTA_XIP       0x10000000
+#define SMSTA_XEN       0x08000000
+#define SMSTA_MTN       0x00200000      /* NACK */
+#define SMSTA_MRNE      0x00080000      /* RX FIFO not empty */
+/*
+ * Not in i2c-pasemi. The A5 driver waits for its transfer with IMASK
+ * 0x00b00040 (MTO, MTN, this bit, TOM) after writing 0x100 to 0x2c, so this
+ * is taken as its "transfer done" interrupt, raised with XEN.
+ */
+#define SMSTA_XDN       0x00100000
+
+#define RX_FIFO_SIZE    256
+
+struct S5L8940I2CState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    qemu_irq irq;
+    I2CBus *bus;
+
+    uint32_t smsta, imask, ctl, reg08, reg0c, reg10;
+    uint32_t hi[8];                         /* 0x20-0x3c: 0x28 REV in i2c-pasemi, 0x2c written 0x100 */
+    bool in_xfer;
+    uint8_t rx[RX_FIFO_SIZE];
+    unsigned rx_head, rx_count;
+};
+
+static bool i2c_trace(void)
+{
+    static int on = -1;
+
+    if (on < 0) {
+        on = g_strcmp0(getenv("I2C_TRACE"), "1") == 0;
+    }
+    return on;
+}
+
+static void s5l8940_i2c_update(S5L8940I2CState *s)
+{
+    qemu_set_irq(s->irq, (s->smsta & s->imask) != 0);
+}
+
+static void rx_push(S5L8940I2CState *s, uint8_t b)
+{
+    if (s->rx_count < RX_FIFO_SIZE) {
+        s->rx[(s->rx_head + s->rx_count++) % RX_FIFO_SIZE] = b;
+    }
+}
+
+static void s5l8940_i2c_stop(S5L8940I2CState *s)
+{
+    if (s->in_xfer) {
+        i2c_end_transfer(s->bus);
+        s->in_xfer = false;
+    }
+    s->smsta |= SMSTA_XEN | SMSTA_XDN;
+}
+
+static void s5l8940_i2c_command(S5L8940I2CState *s, uint32_t cmd)
+{
+    if (cmd & MTX_START) {
+        uint8_t addr = cmd & 0xff;
+
+        if (i2c_start_transfer(s->bus, addr >> 1, addr & 1)) {
+            /* Nobody answered: NACK, and the transfer is over. */
+            s->in_xfer = false;
+            s->smsta |= SMSTA_MTN | SMSTA_XEN | SMSTA_XDN;
+            i2c_end_transfer(s->bus);
+            return;
+        }
+        s->in_xfer = true;
+    } else if (cmd & MTX_READ) {
+        unsigned n = (cmd & 0xff) ? (cmd & 0xff) : 256;
+
+        for (unsigned i = 0; i < n && s->in_xfer; i++) {
+            rx_push(s, i2c_recv(s->bus));
+        }
+    } else if (s->in_xfer) {
+        if (i2c_send(s->bus, cmd & 0xff)) {
+            s->smsta |= SMSTA_MTN;
+        }
+    }
+    if (cmd & MTX_STOP) {
+        s5l8940_i2c_stop(s);
+    }
+}
+
+static uint64_t s5l8940_i2c_read(void *opaque, hwaddr addr, unsigned size)
+{
+    S5L8940I2CState *s = opaque;
+    uint32_t v = 0;
+
+    switch (addr) {
+    case I2C_MRXFIFO:
+        if (s->rx_count) {
+            v = s->rx[s->rx_head];
+            s->rx_head = (s->rx_head + 1) % RX_FIFO_SIZE;
+            s->rx_count--;
+        } else {
+            v = MRX_EMPTY;
+        }
+        break;
+    case I2C_REG08:
+        v = s->reg08;
+        break;
+    case I2C_REG0C:
+        v = s->reg0c;
+        break;
+    case I2C_REG10:
+        v = s->reg10;
+        break;
+    case I2C_SMSTA:
+        v = s->smsta | (s->rx_count ? SMSTA_MRNE : 0);
+        break;
+    case I2C_IMASK:
+        v = s->imask;
+        break;
+    case I2C_CTL:
+        v = s->ctl;
+        break;
+    case 0x20 ... 0x3c:
+        v = s->hi[(addr - 0x20) / 4];
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "s5l8940.i2c: read of 0x%" HWADDR_PRIx "\n", addr);
+        break;
+    }
+    if (i2c_trace()) {
+        qemu_log("%s: read  0x%02" HWADDR_PRIx " -> 0x%08x\n",
+                 object_get_canonical_path_component(OBJECT(s)), addr, v);
+    }
+    return v;
+}
+
+static void s5l8940_i2c_write(void *opaque, hwaddr addr, uint64_t val64, unsigned size)
+{
+    S5L8940I2CState *s = opaque;
+    uint32_t val = val64;
+
+    if (i2c_trace()) {
+        qemu_log("%s: write 0x%02" HWADDR_PRIx " <- 0x%08x\n",
+                 object_get_canonical_path_component(OBJECT(s)), addr, val);
+    }
+    switch (addr) {
+    case I2C_MTXFIFO:
+        s5l8940_i2c_command(s, val);
+        break;
+    case I2C_REG08:
+        s->reg08 = val;
+        break;
+    case I2C_REG0C:
+        s->reg0c = val;
+        break;
+    case I2C_REG10:
+        s->reg10 = val;
+        break;
+    case I2C_SMSTA:
+        s->smsta &= ~val;
+        break;
+    case I2C_IMASK:
+        s->imask = val;
+        break;
+    case I2C_CTL:
+        s->ctl = val;
+        break;
+    case 0x20 ... 0x3c:
+        s->hi[(addr - 0x20) / 4] = val;
+        break;
+    default:
+        qemu_log_mask(LOG_UNIMP, "s5l8940.i2c: write 0x%x to 0x%" HWADDR_PRIx "\n", val, addr);
+        return;
+    }
+    s5l8940_i2c_update(s);
+}
+
+static const MemoryRegionOps s5l8940_i2c_ops = {
+    .read = s5l8940_i2c_read,
+    .write = s5l8940_i2c_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void s5l8940_i2c_reset_hold(Object *obj, ResetType type)
+{
+    S5L8940I2CState *s = S5L8940_I2C(obj);
+
+    s->smsta = s->imask = s->ctl = s->reg08 = s->reg0c = s->reg10 = 0;
+    memset(s->hi, 0, sizeof(s->hi));
+    s->in_xfer = false;
+    s->rx_head = s->rx_count = 0;
+    s5l8940_i2c_update(s);
+}
+
+static void s5l8940_i2c_init(Object *obj)
+{
+    S5L8940I2CState *s = S5L8940_I2C(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &s5l8940_i2c_ops, s, "s5l8940.i2c", 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+    s->bus = i2c_init_bus(DEVICE(obj), "i2c");
+}
+
+static void s5l8940_i2c_class_init(ObjectClass *klass, const void *data)
+{
+    RESETTABLE_CLASS(klass)->phases.hold = s5l8940_i2c_reset_hold;
+}
+
+/*
+ * ---- D1881 PMU: 256 one-byte registers behind a one-byte register address ----
+ *
+ * With adc-ctl set (the A6's D1972, "pmu,d1972"), also its ADC and the interrupt that ends a conversion,
+ * read off 14G61's AppleD1972PMU (docs/reports/a6-step1.md 13): _readADCGated (0x810e6440) writes the
+ * channel | 0x20 to adc-ctl (0x48), sleeps until the PMU's interrupt handler has seen the end of the
+ * conversion, reads the 12-bit result from the next two registers ((lo & 0xf) | hi << 4) and writes the
+ * channel back. Without the interrupt every read waited out its second, and AppleEmbeddedTempSensor's,
+ * through backboardd's HID server, kept SpringBoard from its lock screen. The events are nine registers
+ * from 0x01, cleared by reading them (the handler reads all nine and writes none: kept set, it was an
+ * interrupt storm), masked by nine from 0x12; the interrupt (the DT's GPIO, active low) is up while one
+ * is unmasked. The end of a conversion is 0x02 bit 5 (adc-event / adc-event-bit): with it the ADC reads
+ * stopped timing out.
+ */
+#define D1972_EVENTS        9
+
+struct S5L8940D1881State {
+    I2CSlave parent_obj;
+
+    bool addressing;
+    uint8_t reg;
+    uint8_t regs[256];
+    qemu_irq irq;
+    uint8_t adc_ctl, adc_event, adc_event_bit, event_base, mask_base;
+};
+
+static void d1881_update_irq(S5L8940D1881State *s)
+{
+    bool up = false;
+
+    for (unsigned i = 0; i < D1972_EVENTS; i++) {
+        up |= s->regs[s->event_base + i] & ~s->regs[s->mask_base + i];
+    }
+    qemu_set_irq(s->irq, up);
+}
+
+static int d1881_event(I2CSlave *i2c, enum i2c_event event)
+{
+    S5L8940D1881State *s = S5L8940_D1881(i2c);
+
+    if (event == I2C_START_SEND) {
+        s->addressing = true;
+    }
+    return 0;
+}
+
+static uint8_t d1881_recv(I2CSlave *i2c)
+{
+    S5L8940D1881State *s = S5L8940_D1881(i2c);
+    uint8_t reg = s->reg++;
+    uint8_t value = s->regs[reg];
+
+    if (i2c_trace()) {
+        qemu_log("d1881: read  0x%02x -> 0x%02x\n", reg, value);
+    }
+    if (s->adc_ctl && reg >= s->event_base && reg < s->event_base + D1972_EVENTS) {
+        s->regs[reg] = 0;                       /* read to clear: the driver never writes them */
+        d1881_update_irq(s);
+    }
+    return value;
+}
+
+static int d1881_send(I2CSlave *i2c, uint8_t data)
+{
+    S5L8940D1881State *s = S5L8940_D1881(i2c);
+
+    if (s->addressing) {
+        s->addressing = false;
+        s->reg = data;
+        return 0;
+    }
+    if (i2c_trace()) {
+        qemu_log("d1881: write 0x%02x <- 0x%02x\n", s->reg, data);
+    }
+    if (s->adc_ctl && s->reg >= s->event_base && s->reg < s->event_base + D1972_EVENTS) {
+        s->regs[s->reg++] &= ~data;
+        d1881_update_irq(s);
+        return 0;
+    }
+    if (s->adc_ctl && s->reg == s->adc_ctl && (data & 0x20)) {
+        s->regs[s->adc_ctl + 1] = 0x00;     /* half scale: 0x800 */
+        s->regs[s->adc_ctl + 2] = 0x80;
+        s->regs[s->adc_event] |= s->adc_event_bit;
+    }
+    s->regs[s->reg++] = data;
+    if (s->adc_ctl) {
+        d1881_update_irq(s);
+    }
+    return 0;
+}
+
+static void d1881_reset_hold(Object *obj, ResetType type)
+{
+    S5L8940D1881State *s = S5L8940_D1881(obj);
+
+    s->addressing = false;
+    s->reg = 0;
+    memset(s->regs, 0, sizeof(s->regs));
+    if (s->adc_ctl) {
+        memset(s->regs + s->mask_base, 0xff, D1972_EVENTS);
+        d1881_update_irq(s);
+    }
+}
+
+static void d1881_init(Object *obj)
+{
+    S5L8940D1881State *s = S5L8940_D1881(obj);
+
+    qdev_init_gpio_out_named(DEVICE(obj), &s->irq, "irq", 1);
+}
+
+static const Property d1881_properties[] = {
+    DEFINE_PROP_UINT8("adc-ctl", S5L8940D1881State, adc_ctl, 0),
+    DEFINE_PROP_UINT8("adc-event", S5L8940D1881State, adc_event, 0x02),
+    DEFINE_PROP_UINT8("adc-event-bit", S5L8940D1881State, adc_event_bit, 0x20),
+    DEFINE_PROP_UINT8("event-base", S5L8940D1881State, event_base, 0x01),
+    DEFINE_PROP_UINT8("mask-base", S5L8940D1881State, mask_base, 0x12),
+};
+
+static void d1881_class_init(ObjectClass *klass, const void *data)
+{
+    I2CSlaveClass *k = I2C_SLAVE_CLASS(klass);
+
+    k->event = d1881_event;
+    k->recv = d1881_recv;
+    k->send = d1881_send;
+    RESETTABLE_CLASS(klass)->phases.hold = d1881_reset_hold;
+    device_class_set_props(DEVICE_CLASS(klass), d1881_properties);
+}
+
+static const TypeInfo s5l8940_i2c_types[] = {
+    {
+        .name = TYPE_S5L8940_I2C,
+        .parent = TYPE_SYS_BUS_DEVICE,
+        .instance_size = sizeof(S5L8940I2CState),
+        .instance_init = s5l8940_i2c_init,
+        .class_init = s5l8940_i2c_class_init,
+    },
+    {
+        .name = TYPE_S5L8940_D1881,
+        .parent = TYPE_I2C_SLAVE,
+        .instance_size = sizeof(S5L8940D1881State),
+        .instance_init = d1881_init,
+        .class_init = d1881_class_init,
+    },
+};
+
+DEFINE_TYPES(s5l8940_i2c_types)
diff --git a/hw/arm/s5l8940_iop.c b/hw/arm/s5l8940_iop.c
new file mode 100644
index 0000000000..e6db98c318
--- /dev/null
+++ b/hw/arm/s5l8940_iop.c
@@ -0,0 +1,772 @@
+/*
+ * S5L8940X ("A5") IOP: high-level emulation of what the AP sees of it.
+ *
+ * The A5's IOP is an ARMv7 core running "EmbeddedIOP for s5l8942xiop"
+ * (iBoot-1940 in 7.1.2), which drives the PPN NAND for AppleIOPFMI. Its
+ * firmware never runs here; this device answers the AP's side of it:
+ *
+ * - The control block (DT iop reg, arm-io +0xf300000). AppleA5IOP-14's
+ *   startCPU (11D257 0x80e2d93c) writes +0x0 = 0, +0x4 = the firmware's
+ *   physical base, +0x34 = 0x1ff01ff, then +0x0 = 1; stopCPU writes +0x0 = 0.
+ * - The doorbell: AppleA5IOP's function-doorbell is the AIC's IPID function,
+ *   which sets an IPID vector (kAICSWGenSet); the IOP answers on vector 2
+ *   (DT iop interrupts), and the AIC driver clears it as it dispatches.
+ * - EmbeddedIOP-50's rings. The firmware's 'cnfg' block (0x13000 into the
+ *   7.1.2 image) gets, from the AP: +0x4 flags, +0x8 the message buffer,
+ *   +0xc debug flags, and per endpoint handle h < 10 the ring's address at
+ *   +0x10 + 8h and its slot count at +0x14 + 8h (registerEndpoint,
+ *   0x80cce9f8). A slot is 64 bytes; word 0 is the item with bit 0 for its
+ *   owner (IOPEndpoint::sendMessage/receiveMessage, 0x80ccf470/0x80ccf39c).
+ *   On a command endpoint the AP posts item | 0 and the IOP hands the slot
+ *   back as item | 1 once the command is done.
+ *
+ * Endpoints (EmbeddedIOP::start, table 0x80cd0f78): 0 control (2 slots),
+ * 1 messages from the IOP, then 2 to 8 for the IOP's services; AppleIOPFMI's
+ * two buses use 3-slot rings.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/timer.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/core/sysbus.h"
+#include "hw/core/qdev-properties.h"
+#include "hw/arm/s5l8940.h"
+#include "system/address-spaces.h"
+#include "migration/vmstate.h"
+#include "qemu/error-report.h"
+
+OBJECT_DECLARE_SIMPLE_TYPE(S5L8940IOPState, S5L8940_IOP)
+
+#define IOP_REG_SIZE        0x1000
+#define IOP_CTRL            0x00
+#define IOP_FW_BASE         0x04
+#define IOP_CTRL_RUN        1u
+
+#define IOP_DOORBELL_VECTOR 3       /* DT iop function-doorbell: IPID 3 */
+#define IOP_NMI_VECTOR      2       /* function-nmi: IPID 2 (with 1) */
+#define IOP_AP_VECTOR       2       /* DT iop interrupts */
+
+#define CFG_MAGIC           0x636e6667  /* 'cnfg' */
+#define CFG_SCAN_MAX        0x100000
+#define CFG_RING(h)         (0x10 + 8 * (h))
+#define CFG_COUNT(h)        (0x14 + 8 * (h))
+#define IOP_ENDPOINTS       10
+#define RING_SLOT           0x40
+#define RING_MAX            64
+
+#define EP_CONTROL          0
+#define EP_MESSAGE          1
+
+/*
+ * AppleIOPFMI-93 commands: 512 bytes each, opcode at +0, status at +8 (1 done, 2 blank,
+ * 0x8xxxxxxx errors: _fmiTranslateResult 0x80b1af84), bus at +0x10, flags at +0x14.
+ * Opcodes as the firmware's fmi_message_process (0x1088) dispatches them.
+ */
+#define FMI_CMD_SIZE        0x200
+#define FMI_STATUS          0x08
+#define FMI_BUS             0x10
+#define FMI_CE              0x18        /* u16 */
+#define FMI_OP_SET_CONFIG   0x01
+#define FMI_OP_ERASE_SINGLE 0x03        /* h2fmi_ppn_iop erase (0x7de0): +0x1c block */
+#define FMI_OP_WRITE_BOOTPAGE 0x0a      /* h2fmi_ppn_iop_write_bootpage (0x8468) */
+#define FMI_OP_READ_BOOTPAGE 0x0b       /* h2fmi_ppn_iop_read_bootpage (0x83b4) */
+#define FMI_OP_READ_CAU_BBT 0x0d        /* h2fmi_ppn_iop_read_cau_bbt (0x84d8) */
+#define FMI_OP_READ_MULTIPLE 0x10       /* h2fmi_ppn_iop_read_multiple (0x7fbc) */
+#define FMI_OP_ERASE_MULTIPLE 0x11      /* h2fmi_ppn_iop_erase_multiple (0x7d5c) */
+#define FMI_OP_WRITE_MULTIPLE 0x12      /* h2fmi_ppn_iop_write_multiple (0x822c) */
+#define FMI_OP_CONTROLLER_INFO 0x16     /* h2fmi_ppn_iop_get_controller_info (0x861c) */
+#define FMI_OP_DIE_INFO     0x17        /* 0x8798: die unique id at +0x20, die chip id at +0x30 */
+#define FMI_OP_TEMPERATURE  0x19        /* AppleIOPFMI::_fmiGetTemperatureGated: s16 at +0x18 */
+/* The multi-page commands: {segments, bytes} of the data and meta scatter lists ({IOP address,
+ * length} pairs) and of the PPN command itself. */
+#define FMI_DATA_SGL        0x1c
+#define FMI_DATA_SGL_LEN    0x20
+#define FMI_META_SGL        0x24
+#define FMI_META_SGL_LEN    0x28
+#define FMI_PPN_CMD         0x2c
+#define FMI_PPN_CMD_LEN     0x30
+/*
+ * The PPN command (fmiss_ppn_read_multi 0x8a28, h2fmi_ppn_process_error_list 0x6524): u16 page count
+ * at +8, the physical CE of CE index k at +0xe + 6k (k < 3), and from +0x20 one 12-byte entry a page:
+ * {u32 row; u8 CE index; u8; u8 status, which the IOP ORs a failing page's PPN status into; ...}.
+ */
+#define PPN_CMD_STATUS      0x0c        /* u8: the OR of every page's status */
+#define PPN_CMD_COUNT       0x08
+#define PPN_CMD_CE(k)       (0x0e + 6 * (k))
+#define PPN_CMD_ENTRY(i)    (0x1c + 12 * (i))
+#define PPN_ENTRY_LEN       0           /* u16: bytes to read from the column on, 0 for the page */
+#define PPN_ENTRY_COL       2           /* u16 */
+#define PPN_ENTRY_ROW       4
+#define PPN_ENTRY_CE_IDX    8
+#define PPN_ENTRY_STATUS    10
+#define PPN_CMD_MAX_PAGES   256
+/* PPN operation status: ready, the page read erased, general error (H2fmi_ppn.c read_bootpage, 0x6220). */
+#define PPN_STATUS_READY    0x40
+#define PPN_STATUS_CLEAN    0x08
+#define PPN_STATUS_FAIL     0x01
+#define FMI_STATUS_OK       1
+#define FMI_STATUS_BLANK    2
+#define FMI_STATUS_UNIMPLEMENTED 0x80000005
+
+/*
+ * The PPN device: one CE of 2 CAUs x 0x420 blocks x 128 pages of 8 KiB and 32
+ * bytes of metadata, as tools/a5/n78_kboot.py's N78_NAND puts it in the DT.
+ * Rows are {cau, block, page} in cau-bits, block-bits, page-bits.
+ */
+#define PPN_CAUS            2
+#define PPN_CAU_BITS        1
+#define PPN_BLOCKS_PER_CAU  0x420
+#define PPN_BLOCK_BITS      11
+#define PPN_PAGES_PER_BLOCK 128
+#define PPN_SLC_PAGES       64
+#define PPN_PAGE_BITS       7
+#define PPN_PAGE_BYTES      0x2000
+#define PPN_META_BYTES      0x20
+#define PPN_BOOT_BYTES      0x600       /* AppleIOPFMI's #bootloader-bytes */
+#define PPN_LBA_BYTES       0x1000      /* DT logical-page-size */
+#define PPN_LBA_SPAN        0x1010      /* a logical page and its meta-per-logical-page */
+#define PPN_LBAS_PER_PAGE   2
+
+struct S5L8940IOPState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    DeviceState *aic;
+    uint32_t regs[IOP_REG_SIZE / 4];
+    bool running;
+    uint32_t cfg;               /* physical address of the 'cnfg' block, 0 until found */
+    uint32_t idx[IOP_ENDPOINTS];
+    uint64_t ops[0x20], pages;  /* IOP_TRACE statistics */
+    char *nand_path;            /* nand=: a directory for the page store, else it is in memory */
+    int fd[2];                  /* the store's files: STORE_PAGES, STORE_BOOT */
+    GHashTable *mem[2];         /* the in-memory store: index -> record */
+};
+
+/*
+ * The page store: per CE (one here), the main array by row, PPN_PAGE_BYTES + PPN_META_BYTES a
+ * record, and the boot pages by page, PPN_BOOT_BYTES. With nand=DIR they are the sparse files
+ * DIR/ce0.pages and DIR/ce0.boot, kept inverted (XOR 0xff) so a hole reads erased; otherwise
+ * records live in memory for this run only.
+ */
+enum { STORE_PAGES, STORE_BOOT };
+static const unsigned store_rec[2] = { PPN_PAGE_BYTES + PPN_META_BYTES, PPN_BOOT_BYTES };
+static const char *const store_name[2] = { "ce0.pages", "ce0.boot" };
+
+/* IOP_TRACE=1: log the IOP's commands, the multi-page I/O only when a page fails; 2: all of it. */
+static int iop_trace(void)
+{
+    static int level = -1;
+
+    if (level < 0) {
+        level = getenv("IOP_TRACE") ? atoi(getenv("IOP_TRACE")) : 0;
+    }
+    return level;
+}
+
+#define IOP_LOG(...) do { if (iop_trace()) { qemu_log("iop: " __VA_ARGS__); } } while (0)
+
+static uint32_t ld32(hwaddr pa)
+{
+    return address_space_ldl_le(&address_space_memory, pa, MEMTXATTRS_UNSPECIFIED, NULL);
+}
+
+static void st32(hwaddr pa, uint32_t v)
+{
+    address_space_stl_le(&address_space_memory, pa, v, MEMTXATTRS_UNSPECIFIED, NULL);
+}
+
+static uint32_t ld16(hwaddr pa)
+{
+    return address_space_lduw_le(&address_space_memory, pa, MEMTXATTRS_UNSPECIFIED, NULL);
+}
+
+static uint8_t ld8(hwaddr pa)
+{
+    return address_space_ldub(&address_space_memory, pa, MEMTXATTRS_UNSPECIFIED, NULL);
+}
+
+static void st8(hwaddr pa, uint8_t v)
+{
+    address_space_stb(&address_space_memory, pa, v, MEMTXATTRS_UNSPECIFIED, NULL);
+}
+
+/*
+ * IOP-visible addresses: the IOP sees DRAM at 0xc0000000, as the A4's did (its
+ * firmware's memory map), so the AP's 0x80000000 + n is 0xc0000000 + n there.
+ */
+#define IOP_DRAM_BASE       0xc0000000u
+
+static hwaddr iop_pa(S5L8940IOPState *s, uint32_t iop_addr)
+{
+    return iop_addr >= IOP_DRAM_BASE ? iop_addr - IOP_DRAM_BASE + S5L8940_DRAM_BASE : iop_addr;
+}
+
+static void iop_dump(const char *what, hwaddr pa, unsigned len)
+{
+    if (!iop_trace()) {
+        return;
+    }
+    for (unsigned off = 0; off < len; off += 32) {
+        qemu_log("iop:   %s +%03x:", what, off);
+        for (unsigned i = 0; i < 32 && off + i < len; i += 4) {
+            qemu_log(" %08x", ld32(pa + off + i));
+        }
+        qemu_log("\n");
+    }
+}
+
+static void iop_find_cfg(S5L8940IOPState *s)
+{
+    hwaddr fw = s->regs[IOP_FW_BASE / 4];
+
+    s->cfg = 0;
+    for (hwaddr off = 0; off < CFG_SCAN_MAX; off += 0x1000) {
+        if (ld32(fw + off) == CFG_MAGIC) {
+            s->cfg = fw + off;
+            break;
+        }
+    }
+    IOP_LOG("start: firmware at 0x%" HWADDR_PRIx ", cnfg at 0x%x\n", fw, s->cfg);
+    if (s->cfg) {
+        iop_dump("cnfg", s->cfg, 0x60);
+    }
+}
+
+static void iop_control(S5L8940IOPState *s, hwaddr buf)
+{
+    uint32_t op = ld32(buf);
+
+    IOP_LOG("control '%c%c%c%c' (0x%08x)\n", op >> 24, op >> 16, op >> 8, op, op);
+    iop_dump("ctl", buf, 0x40);
+    st32(buf + 4, 0);           /* status: done */
+}
+
+static void put_str(hwaddr pa, const char *str, unsigned len)
+{
+    char buf[32] = { 0 };
+
+    strncpy(buf, str, sizeof(buf));
+    address_space_write(&address_space_memory, pa, MEMTXATTRS_UNSPECIFIED, buf, len);
+}
+
+/* The device's parameter page as the firmware hands it to the kernel (layout: 0x861c). */
+static void fmi_controller_info(S5L8940IOPState *s, hwaddr cmd)
+{
+    static const uint8_t mfg_id[8] = { 0x98, 0xde, 0x84, 0x93, 0x72, 0x57, 0, 0 };
+    static const uint8_t timings[10] = { 25, 20, 10, 15, 100, 5, 12, 25, 10, 12 };
+
+    put_str(cmd + 0x1c, "CT-PPN-1.0", 16);              /* firmware version */
+    put_str(cmd + 0x2c, "", 16);                        /* package assembly code */
+    put_str(cmd + 0x3c, "classictouch-n78", 16);        /* controller unique id */
+    put_str(cmd + 0x4c, "", 16);                        /* controller hw id */
+    address_space_write(&address_space_memory, cmd + 0x5c, MEMTXATTRS_UNSPECIFIED, mfg_id, 8);
+    put_str(cmd + 0x64, "CTNAND", 10);                  /* marketing name (PPN 1.5) */
+    st32(cmd + 0x70, PPN_CAUS);
+    st32(cmd + 0x74, PPN_CAU_BITS);
+    st32(cmd + 0x78, PPN_BLOCKS_PER_CAU);
+    st32(cmd + 0x7c, PPN_BLOCK_BITS);
+    st32(cmd + 0x80, PPN_PAGES_PER_BLOCK);
+    st32(cmd + 0x84, PPN_SLC_PAGES);
+    st32(cmd + 0x88, PPN_PAGE_BITS);
+    st32(cmd + 0x8c, 1);                                /* address bits for bits-per-cell */
+    st32(cmd + 0x90, 2);                                /* default bits per cell (MLC) */
+    st32(cmd + 0x94, PPN_PAGE_BYTES + PPN_META_BYTES);
+    st32(cmd + 0x98, 1);                                /* dies */
+    for (int i = 0; i < 10; i++) {
+        st32(cmd + 0x9c + 4 * i, timings[i]);           /* tRC tREA tREH tRHOH tRHZ tRLOH tRP tWC tWH tWP */
+    }
+    st32(cmd + 0xc4, 8);                                /* read queue */
+    st32(cmd + 0xc8, 8);                                /* program queue */
+    st32(cmd + 0xcc, 8);                                /* erase queue */
+    st32(cmd + 0xd0, 64);                               /* prep function buffer */
+    st32(cmd + 0xd4, 1);                                /* tRST ms */
+    st32(cmd + 0xd8, 1);                                /* tPURST ms */
+    st32(cmd + 0xdc, 1);                                /* tSCE ms */
+    st32(cmd + 0xe0, 10);                               /* tCERDY us */
+    st32(cmd + FMI_STATUS, FMI_STATUS_OK);
+}
+
+/* A boot page: {ce u16 +0x18, page +0x1c, buffer +0x20, corrections +0x24}, 0x600 bytes (0x83b4). */
+/* Read record idx of a store; false when it is erased (all 0xff). */
+static bool store_read(S5L8940IOPState *s, int kind, uint32_t idx, uint8_t *buf)
+{
+    unsigned len = store_rec[kind];
+    bool erased = true;
+
+    if (s->fd[kind] >= 0) {
+        ssize_t n = pread(s->fd[kind], buf, len, (off_t)idx * len);
+
+        memset(buf + MAX(n, 0), 0, len - MAX(n, 0));
+        for (unsigned i = 0; i < len; i++) {
+            buf[i] ^= 0xff;
+        }
+    } else {
+        uint64_t key = idx;
+        uint8_t *rec = g_hash_table_lookup(s->mem[kind], &key);
+
+        if (rec) {
+            memcpy(buf, rec, len);
+        } else {
+            memset(buf, 0xff, len);
+        }
+    }
+    for (unsigned i = 0; i < len && erased; i++) {
+        erased = buf[i] == 0xff;
+    }
+    return !erased;
+}
+
+/* Program record idx (NULL: erase it). */
+static void store_write(S5L8940IOPState *s, int kind, uint32_t idx, const uint8_t *data)
+{
+    unsigned len = store_rec[kind];
+
+    if (s->fd[kind] >= 0) {
+        g_autofree uint8_t *inv = g_malloc0(len);
+
+        if (data) {
+            for (unsigned i = 0; i < len; i++) {
+                inv[i] = data[i] ^ 0xff;
+            }
+        }
+        if (pwrite(s->fd[kind], inv, len, (off_t)idx * len) != len) {
+            error_report("s5l8940.iop: cannot write %s: %s", store_name[kind], strerror(errno));
+        }
+    } else if (data) {
+        uint64_t *key = g_new(uint64_t, 1);
+
+        *key = idx;
+        g_hash_table_replace(s->mem[kind], key, g_memdup2(data, len));
+    } else {
+        uint64_t key = idx;
+
+        g_hash_table_remove(s->mem[kind], &key);
+    }
+}
+
+/*
+ * Erase a block. On a file store a block's 128 records are 257 x 4 KiB, so on macOS the range is
+ * punched out of the sparse file (reads as erased) rather than written with a megabyte of zeros:
+ * the FTL's format erases every block of the device.
+ */
+static void store_erase_block(S5L8940IOPState *s, uint32_t row)
+{
+    uint32_t first = row & ~(PPN_PAGES_PER_BLOCK - 1);
+
+#ifdef F_PUNCHHOLE
+    if (s->fd[STORE_PAGES] >= 0) {
+        struct fpunchhole hole = {
+            .fp_offset = (off_t)first * store_rec[STORE_PAGES],
+            .fp_length = (off_t)PPN_PAGES_PER_BLOCK * store_rec[STORE_PAGES],
+        };
+        struct stat st;
+
+        if (fstat(s->fd[STORE_PAGES], &st) == 0 && hole.fp_offset >= st.st_size) {
+            return;                                 /* past the file's end: never written */
+        }
+        if (fcntl(s->fd[STORE_PAGES], F_PUNCHHOLE, &hole) == 0) {
+            return;
+        }
+    }
+#endif
+    for (uint32_t p = 0; p < PPN_PAGES_PER_BLOCK; p++) {
+        store_write(s, STORE_PAGES, first + p, NULL);
+    }
+}
+
+/*
+ * SwissPPN's row (PPNMISC 0x80d110ac): {page, block << page bits, cau << (page + block bits)}, and
+ * above them a bit for SLC mode, which addresses the same block's first slc-pages pages; the store
+ * keeps one copy of a page either way.
+ */
+#define PPN_SLC_BIT         (1u << (PPN_PAGE_BITS + PPN_BLOCK_BITS + PPN_CAU_BITS))
+
+/* Rows outside the device (cau, block or page past the geometry) are refused. */
+static bool ppn_row_ok(uint32_t row)
+{
+    uint32_t page = row & ((1u << PPN_PAGE_BITS) - 1);
+    uint32_t block = (row >> PPN_PAGE_BITS) & ((1u << PPN_BLOCK_BITS) - 1);
+    uint32_t cau = row >> (PPN_PAGE_BITS + PPN_BLOCK_BITS);
+
+    return cau < PPN_CAUS && block < PPN_BLOCKS_PER_CAU && page < PPN_PAGES_PER_BLOCK;
+}
+
+/* A boot page: {ce u16 +0x18, page +0x1c, buffer +0x20, corrections +0x24}, 0x600 bytes (0x83b4). */
+static void fmi_read_bootpage(S5L8940IOPState *s, hwaddr cmd)
+{
+    uint8_t page[PPN_BOOT_BYTES];
+    bool programmed = store_read(s, STORE_BOOT, ld32(cmd + 0x1c), page);
+
+    address_space_write(&address_space_memory, iop_pa(s, ld32(cmd + 0x20)), MEMTXATTRS_UNSPECIFIED,
+                        page, PPN_BOOT_BYTES);
+    st32(cmd + FMI_STATUS, programmed ? FMI_STATUS_OK : FMI_STATUS_BLANK);
+}
+
+static void fmi_write_bootpage(S5L8940IOPState *s, hwaddr cmd)
+{
+    uint8_t page[PPN_BOOT_BYTES];
+
+    address_space_read(&address_space_memory, iop_pa(s, ld32(cmd + 0x20)), MEMTXATTRS_UNSPECIFIED,
+                       page, PPN_BOOT_BYTES);
+    store_write(s, STORE_BOOT, ld32(cmd + 0x1c), page);
+    st32(cmd + FMI_STATUS, FMI_STATUS_OK);
+}
+
+/* Erase one block, +0x1c its index in the CE's row space (0x7de0: row = block << page bits). */
+static void fmi_erase_single(S5L8940IOPState *s, hwaddr cmd)
+{
+    uint32_t row = (ld32(cmd + 0x1c) << PPN_PAGE_BITS) & ~PPN_SLC_BIT;
+
+    if (ppn_row_ok(row)) {
+        store_erase_block(s, row);
+    }
+    st32(cmd + FMI_STATUS, FMI_STATUS_OK);
+}
+
+/*
+ * A scatter list {IOP address, length}[] as a cursor: sgl_copy moves len bytes between it and buf,
+ * to the guest when to_guest.
+ */
+typedef struct {
+    S5L8940IOPState *s;
+    hwaddr list;
+    uint32_t count, seg;
+    uint32_t off;               /* into the current segment */
+} SGL;
+
+static void sgl_init(SGL *g, S5L8940IOPState *s, uint32_t list, uint32_t bytes)
+{
+    *g = (SGL){ .s = s, .list = iop_pa(s, list), .count = list ? bytes / 8 : 0 };
+}
+
+static bool sgl_copy(SGL *g, uint8_t *buf, uint32_t len, bool to_guest)
+{
+    while (len) {
+        uint32_t addr, seglen, n;
+
+        if (g->seg >= g->count) {
+            return false;
+        }
+        addr = ld32(g->list + 8 * g->seg);
+        seglen = ld32(g->list + 8 * g->seg + 4);
+        n = MIN(len, seglen - g->off);
+        address_space_rw(&address_space_memory, iop_pa(g->s, addr) + g->off, MEMTXATTRS_UNSPECIFIED,
+                         buf, n, to_guest);
+        buf += n;
+        len -= n;
+        g->off += n;
+        if (g->off >= seglen) {
+            g->seg++;
+            g->off = 0;
+        }
+    }
+    return true;
+}
+
+/*
+ * Read, program or erase the pages a PPN command lists (0x10, 0x12, 0x11). A page holds
+ * PPN_LBAS_PER_PAGE logical pages, each its 4 KiB of data then its metadata (PPN_LBA_SPAN bytes,
+ * the device's column layout), and an entry may read a span of them: {u16 length, u16 column} ahead
+ * of its row (SwissPPN's _analyzeSpansReadStatuses prints them), 0 meaning the whole page. Data and
+ * meta move in entry order through their scatter lists, a logical page's share of each list apiece.
+ * As the IOP firmware does (fmiss_ppn_read_multi 0x8a28, program 0x9584, erase 0x67e0), each entry
+ * gets its page's PPN status (READY; READY | CLEAN | FAIL, 0x49, for a page that reads erased;
+ * READY | FAIL) and the command's +0xc byte their OR; the kernel looks at the pages only when that is
+ * not just READY (SwissPPN 0x80cfbdc0), and then knows 0x40, 0x42 to 0x45, 0x49, 0x51 and 0xc1 alone
+ * (_analyzeSpansReadStatuses 0x80d14e7c: any other is "an unidentified status").
+ */
+static void fmi_ppn_multi(S5L8940IOPState *s, hwaddr cmd, uint32_t op)
+{
+    hwaddr pc = iop_pa(s, ld32(cmd + FMI_PPN_CMD));
+    uint32_t count = ld16(pc + PPN_CMD_COUNT);
+    uint32_t data_total = 0, meta_total = 0, lbas = 0, data_lba = 0, meta_lba = 0;
+    g_autofree uint8_t *rec = g_malloc(PPN_PAGE_BYTES + PPN_META_BYTES);
+    uint8_t all = 0;
+    SGL data, meta;
+
+    if (!count || count > PPN_CMD_MAX_PAGES) {
+        IOP_LOG("ppn op 0x%x: %u pages\n", op, count);
+        st32(cmd + FMI_STATUS, 0x80000004);         /* invalid parameter */
+        return;
+    }
+    for (uint32_t i = 0; i < count; i++) {
+        uint32_t len = ld16(pc + PPN_CMD_ENTRY(i) + PPN_ENTRY_LEN);
+
+        lbas += len ? MAX(len / PPN_LBA_SPAN, 1) : PPN_LBAS_PER_PAGE;
+    }
+    if (op != FMI_OP_ERASE_MULTIPLE) {
+        sgl_init(&data, s, ld32(cmd + FMI_DATA_SGL), ld32(cmd + FMI_DATA_SGL_LEN));
+        sgl_init(&meta, s, ld32(cmd + FMI_META_SGL), ld32(cmd + FMI_META_SGL_LEN));
+        for (uint32_t i = 0; i < data.count; i++) {
+            data_total += ld32(data.list + 8 * i + 4);
+        }
+        for (uint32_t i = 0; i < meta.count; i++) {
+            meta_total += ld32(meta.list + 8 * i + 4);
+        }
+        data_lba = data_total / lbas;
+        meta_lba = meta_total / lbas;
+        if (data_lba > PPN_LBA_BYTES || meta_lba > PPN_LBA_SPAN - PPN_LBA_BYTES) {
+            IOP_LOG("ppn op 0x%x: %u data, %u meta bytes a logical page\n", op, data_lba, meta_lba);
+            st32(cmd + FMI_STATUS, 0x80000004);
+            return;
+        }
+    }
+    s->pages += count;
+    for (uint32_t i = 0; i < count; i++) {
+        hwaddr e = pc + PPN_CMD_ENTRY(i);
+        uint32_t row = ld32(e + PPN_ENTRY_ROW) & ~PPN_SLC_BIT;
+        uint32_t len = ld16(e + PPN_ENTRY_LEN), col = ld16(e + PPN_ENTRY_COL);
+        uint32_t first = len ? MIN(col / PPN_LBA_SPAN, PPN_LBAS_PER_PAGE - 1) : 0;
+        uint32_t n = len ? MIN(MAX(len / PPN_LBA_SPAN, 1), PPN_LBAS_PER_PAGE - first) : PPN_LBAS_PER_PAGE;
+        uint8_t status = PPN_STATUS_READY;
+
+        if (!ppn_row_ok(row)) {
+            IOP_LOG("ppn op 0x%x: page %u row 0x%x outside the device\n", op, i, row);
+            status = PPN_STATUS_READY | PPN_STATUS_FAIL;
+        } else if (op == FMI_OP_ERASE_MULTIPLE) {
+            store_erase_block(s, row);
+        } else if (op == FMI_OP_READ_MULTIPLE) {
+            if (!store_read(s, STORE_PAGES, row, rec)) {
+                status = PPN_STATUS_READY | PPN_STATUS_CLEAN | PPN_STATUS_FAIL;
+            }
+            for (uint32_t k = first; k < first + n; k++) {
+                sgl_copy(&data, rec + k * PPN_LBA_SPAN, data_lba, true);
+                sgl_copy(&meta, rec + k * PPN_LBA_SPAN + PPN_LBA_BYTES, meta_lba, true);
+            }
+        } else {
+            memset(rec, 0xff, PPN_PAGE_BYTES + PPN_META_BYTES);
+            for (uint32_t k = first; k < first + n; k++) {
+                sgl_copy(&data, rec + k * PPN_LBA_SPAN, data_lba, false);
+                sgl_copy(&meta, rec + k * PPN_LBA_SPAN + PPN_LBA_BYTES, meta_lba, false);
+            }
+            store_write(s, STORE_PAGES, row, rec);
+        }
+        st8(e + PPN_ENTRY_STATUS, status);
+        all |= status;
+        if (iop_trace() > 1 || (iop_trace() && status != PPN_STATUS_READY && op != FMI_OP_READ_MULTIPLE)) {
+            IOP_LOG("  ppn op 0x%x [%u/%u] row 0x%x len 0x%x col 0x%x ce_idx %u status 0x%x\n", op, i, count,
+                    row, len, col, ld8(e + PPN_ENTRY_CE_IDX), status);
+        }
+    }
+    st8(pc + PPN_CMD_STATUS, all);
+    st32(cmd + FMI_STATUS, FMI_STATUS_OK);
+}
+
+/* The factory bad block table of one CAU, one bit a block, set for a good block (to be checked). */
+static void fmi_read_cau_bbt(S5L8940IOPState *s, hwaddr cmd)
+{
+    hwaddr buf = iop_pa(s, ld32(iop_pa(s, ld32(cmd + FMI_DATA_SGL))));
+
+    iop_dump("ppncmd", iop_pa(s, ld32(cmd + FMI_PPN_CMD)), 0x40);
+    address_space_set(&address_space_memory, buf, 0xff, PPN_BLOCKS_PER_CAU / 8,
+                      MEMTXATTRS_UNSPECIFIED);
+    st32(cmd + FMI_STATUS, FMI_STATUS_OK);
+}
+
+static void iop_fmi(S5L8940IOPState *s, int h, hwaddr cmd)
+{
+    uint32_t op = ld32(cmd);
+
+    if (op < ARRAY_SIZE(s->ops)) {
+        s->ops[op]++;
+    }
+    if (iop_trace() && !(++s->ops[0] % 200)) {
+        IOP_LOG("stats %.3fs: %" PRIu64 " commands, %" PRIu64 " pages; read %" PRIu64 " write %" PRIu64
+                " erase %" PRIu64 "\n", qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) / 1e9, s->ops[0], s->pages,
+                s->ops[FMI_OP_READ_MULTIPLE], s->ops[FMI_OP_WRITE_MULTIPLE], s->ops[FMI_OP_ERASE_MULTIPLE]);
+    }
+
+    if (iop_trace() > 1 || (op != FMI_OP_READ_MULTIPLE && op != FMI_OP_WRITE_MULTIPLE &&
+                            op != FMI_OP_ERASE_MULTIPLE)) {
+        IOP_LOG("fmi ep %d opcode 0x%x\n", h, op);
+        iop_dump("fmi", cmd, 0xc0);
+    }
+    switch (op) {
+    case FMI_OP_SET_CONFIG:
+        st32(cmd + FMI_STATUS, FMI_STATUS_OK);
+        break;
+    case FMI_OP_CONTROLLER_INFO:
+        fmi_controller_info(s, cmd);
+        break;
+    case FMI_OP_DIE_INFO:
+        put_str(cmd + 0x20, "classictouch-d0", 16);
+        put_str(cmd + 0x30, "", 16);
+        st32(cmd + FMI_STATUS, FMI_STATUS_OK);
+        break;
+    case FMI_OP_TEMPERATURE:
+        st32(cmd + 0x18, 30);                       /* degrees C */
+        st32(cmd + FMI_STATUS, FMI_STATUS_OK);
+        break;
+    case FMI_OP_READ_BOOTPAGE:
+        fmi_read_bootpage(s, cmd);
+        break;
+    case FMI_OP_WRITE_BOOTPAGE:
+        fmi_write_bootpage(s, cmd);
+        break;
+    case FMI_OP_ERASE_SINGLE:
+        fmi_erase_single(s, cmd);
+        break;
+    case FMI_OP_READ_MULTIPLE:
+    case FMI_OP_WRITE_MULTIPLE:
+    case FMI_OP_ERASE_MULTIPLE:
+        if (iop_trace() > 1) {
+            iop_dump("ppncmd", iop_pa(s, ld32(cmd + FMI_PPN_CMD)), 0x40);
+        }
+        fmi_ppn_multi(s, cmd, op);
+        break;
+    case FMI_OP_READ_CAU_BBT:
+        fmi_read_cau_bbt(s, cmd);
+        break;
+    default:
+        st32(cmd + FMI_STATUS, FMI_STATUS_UNIMPLEMENTED);
+        break;
+    }
+}
+
+/* Run whatever the AP has posted on the command endpoints; true if a slot came back. */
+static bool iop_service(S5L8940IOPState *s)
+{
+    bool any = false;
+
+    for (int h = 0; h < IOP_ENDPOINTS; h++) {
+        uint32_t ring = ld32(s->cfg + CFG_RING(h));
+        uint32_t count = ld32(s->cfg + CFG_COUNT(h));
+
+        if (h == EP_MESSAGE || !ring || !count || count > RING_MAX) {
+            continue;
+        }
+        for (uint32_t n = 0; n < count; n++) {
+            hwaddr slot = iop_pa(s, ring) + s->idx[h] * RING_SLOT;
+            uint32_t w0 = ld32(slot);
+            hwaddr item;
+
+            if (!w0 || (w0 & 1)) {
+                break;
+            }
+            item = iop_pa(s, w0 & ~3u);
+            if (h == EP_CONTROL) {
+                iop_control(s, item);
+            } else {
+                iop_fmi(s, h, item);
+            }
+            st32(slot, w0 | 1);
+            s->idx[h] = (s->idx[h] + 1) % count;
+            any = true;
+        }
+    }
+    return any;
+}
+
+static void iop_ipid(void *opaque, int vector)
+{
+    S5L8940IOPState *s = opaque;
+
+    if (iop_trace() > 1) {
+        IOP_LOG("ipid %d (running %d)\n", vector, s->running);
+    }
+    if (vector != IOP_DOORBELL_VECTOR) {
+        return;
+    }
+    s5l8940_aic_sw_set(s->aic, vector, false);     /* the IOP takes its doorbell */
+    if (s->running && s->cfg && iop_service(s)) {
+        s5l8940_aic_sw_set(s->aic, IOP_AP_VECTOR, true);
+    }
+}
+
+static uint64_t iop_read(void *opaque, hwaddr addr, unsigned size)
+{
+    S5L8940IOPState *s = opaque;
+
+    return s->regs[addr / 4];
+}
+
+static void iop_write(void *opaque, hwaddr addr, uint64_t val, unsigned size)
+{
+    S5L8940IOPState *s = opaque;
+
+    IOP_LOG("reg +0x%03" HWADDR_PRIx " <- 0x%08" PRIx64 "\n", addr, val);
+    s->regs[addr / 4] = val;
+    if (addr == IOP_CTRL) {
+        bool run = val & IOP_CTRL_RUN;
+
+        if (run && !s->running) {
+            memset(s->idx, 0, sizeof(s->idx));
+            iop_find_cfg(s);
+        }
+        s->running = run;
+    }
+}
+
+static const MemoryRegionOps iop_ops = {
+    .read = iop_read,
+    .write = iop_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void iop_realize(DeviceState *dev, Error **errp)
+{
+    S5L8940IOPState *s = S5L8940_IOP(dev);
+
+    if (!s->aic) {
+        error_setg(errp, "s5l8940.iop: aic link not set");
+        return;
+    }
+    for (int k = 0; k < 2; k++) {
+        s->fd[k] = -1;
+        s->mem[k] = g_hash_table_new_full(g_int64_hash, g_int64_equal, g_free, g_free);
+        if (s->nand_path) {
+            g_autofree char *path = g_build_filename(s->nand_path, store_name[k], NULL);
+
+            if (g_mkdir_with_parents(s->nand_path, 0755) < 0 ||
+                (s->fd[k] = qemu_open_old(path, O_RDWR | O_CREAT, 0644)) < 0) {
+                error_setg_errno(errp, errno, "s5l8940.iop: cannot open %s", path);
+                return;
+            }
+        }
+    }
+    memory_region_init_io(&s->iomem, OBJECT(dev), &iop_ops, s, "s5l8940.iop", IOP_REG_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(dev), &s->iomem);
+    s5l8940_aic_set_ipid_handler(s->aic, iop_ipid, s);
+}
+
+static void iop_reset_hold(Object *obj, ResetType type)
+{
+    S5L8940IOPState *s = S5L8940_IOP(obj);
+
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->idx, 0, sizeof(s->idx));
+    s->running = false;
+    s->cfg = 0;
+}
+
+static const Property iop_properties[] = {
+    DEFINE_PROP_LINK("aic", S5L8940IOPState, aic, TYPE_S5L8940_AIC, DeviceState *),
+    DEFINE_PROP_STRING("nand", S5L8940IOPState, nand_path),
+};
+
+static void iop_class_init(ObjectClass *klass, const void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+
+    dc->realize = iop_realize;
+    rc->phases.hold = iop_reset_hold;
+    device_class_set_props(dc, iop_properties);
+}
+
+static const TypeInfo iop_info = {
+    .name = TYPE_S5L8940_IOP,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(S5L8940IOPState),
+    .class_init = iop_class_init,
+};
+
+static void iop_register_types(void)
+{
+    type_register_static(&iop_info);
+}
+
+type_init(iop_register_types)
diff --git a/hw/arm/s5l8940_pmgr.c b/hw/arm/s5l8940_pmgr.c
new file mode 100644
index 0000000000..1f78307009
--- /dev/null
+++ b/hw/arm/s5l8940_pmgr.c
@@ -0,0 +1,102 @@
+/*
+ * S5L8940 ("A5") PMGR, DT "pmgr,s5l8940x" (AppleS5L8940XPerformanceController),
+ * first window only (reg 0xF100000, 0x7000; the DT's six other windows stay
+ * unimplemented). Bring-up model: what 7.1.2 and 9.3.5 poll on is answered, the
+ * rest is plain storage.
+ *
+ * - Clock gates at 0x1010 + 4n, through 0x117c on this chip: as on the A4
+ *   (s5l8930_pmgr.c), bits 0-3 request a state and bits 4-7 report it, bit 31
+ *   is a reset pulse. The kernel writes 0xf and reads back; with nothing
+ *   following the request it panicked "Power gate 0x6c enabled before clock
+ *   was enabled". Here the state follows at once and the pulse self-clears.
+ * - Clock configs, read 0x38-0x104 at boot: bit 30 is the A4's change-pending
+ *   bit; a write completes at once, so it never reads set.
+ * - 0x38 is also the CPU clock config iBoot's cpu-clk-cfgs entries are made
+ *   from (n78_kboot.py): source in bits 28-29, divider in bits 0-4.
+ * The A5's timebase is the AIC's (s5l8940_aic.c), so there is no timer here.
+ */
+#include "qemu/osdep.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#include "hw/arm/s5l8940.h"
+
+#define PMGR_SIZE           0x8000
+#define CLKCFG_START        0x38
+#define CLKCFG_END          0x108
+#define CLKCFG_BUSY         (1u << 30)
+#define GATE_START          0x1010
+#define GATE_END            0x1180
+#define GATE_REQ            0x0000000fu
+#define GATE_ACT_SHIFT      4
+#define GATE_RESET          (1u << 31)
+
+struct S5L8940PMGRState {
+    SysBusDevice parent_obj;
+
+    MemoryRegion iomem;
+    uint32_t regs[PMGR_SIZE / 4];
+};
+
+static uint64_t s5l8940_pmgr_read(void *opaque, hwaddr addr, unsigned size)
+{
+    S5L8940PMGRState *s = opaque;
+
+    return s->regs[addr / 4];
+}
+
+static void s5l8940_pmgr_write(void *opaque, hwaddr addr, uint64_t val64, unsigned size)
+{
+    S5L8940PMGRState *s = opaque;
+    uint32_t val = val64;
+
+    if (addr >= GATE_START && addr < GATE_END) {
+        val &= ~(GATE_RESET | (GATE_REQ << GATE_ACT_SHIFT));
+        val |= (val & GATE_REQ) << GATE_ACT_SHIFT;
+    } else if (addr >= CLKCFG_START && addr < CLKCFG_END) {
+        val &= ~CLKCFG_BUSY;
+    }
+    s->regs[addr / 4] = val;
+}
+
+static const MemoryRegionOps s5l8940_pmgr_ops = {
+    .read = s5l8940_pmgr_read,
+    .write = s5l8940_pmgr_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void s5l8940_pmgr_reset_hold(Object *obj, ResetType type)
+{
+    S5L8940PMGRState *s = S5L8940_PMGR(obj);
+
+    memset(s->regs, 0, sizeof(s->regs));
+}
+
+static void s5l8940_pmgr_init(Object *obj)
+{
+    S5L8940PMGRState *s = S5L8940_PMGR(obj);
+
+    memory_region_init_io(&s->iomem, obj, &s5l8940_pmgr_ops, s, "s5l8940.pmgr", PMGR_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->iomem);
+}
+
+static void s5l8940_pmgr_class_init(ObjectClass *klass, const void *data)
+{
+    RESETTABLE_CLASS(klass)->phases.hold = s5l8940_pmgr_reset_hold;
+}
+
+static const TypeInfo s5l8940_pmgr_info = {
+    .name = TYPE_S5L8940_PMGR,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(S5L8940PMGRState),
+    .instance_init = s5l8940_pmgr_init,
+    .class_init = s5l8940_pmgr_class_init,
+};
+
+static void s5l8940_pmgr_register_types(void)
+{
+    type_register_static(&s5l8940_pmgr_info);
+}
+
+type_init(s5l8940_pmgr_register_types)
diff --git a/include/hw/arm/guest-services/gles.h b/include/hw/arm/guest-services/gles.h
index dcc0118e64..f983f51205 100644
