+/*
+ * Whether the guest memory a writeback is about to fill is still the surface's (gles_host_set_owner_check,
+ * which the A5/A6 machines turn on). The pages were found at the bind and kept; once the surface is freed,
+ * or its process gone, they are the kernel's again, and on 10.3.4 a frame written into them later became a
+ * page table entry (0xff6ac1b0, an opaque pixel) or a zone element (docs/reports/a6-step1.md 13). So the
+ * binding process's own tables, at the bind's TTBR0, must still put its first, middle and last page where
+ * they were. A surface without kept pages is written through the caller's mappings: only its own process
+ * may do that. 4.x's kernel unmaps all but the last page a process touched, which is why this is not on
+ * for every machine.
+ */
+static bool gles_surface_owned(CPUState *cpu, GLESSurface *s)
+{
+    if (!s->ttbr) {
+        return true;
+    }
+    if (!s->npages) {
+        return gles_owner_ttbr(cpu) == s->ttbr;
+    }
+    unsigned probe[3] = { 0, s->npages / 2, s->npages - 1 };
+    for (unsigned i = 0; i < 3; i++) {
+        ram_addr_t now;
+        int r = gles_owner_page(cpu, s->ttbr, (s->base & TARGET_PAGE_MASK) + (vaddr)probe[i] * TARGET_PAGE_SIZE,
+                                &now);
+        if (r == 0 || (r > 0 && now != s->pages[probe[i]])) {
+            return false;
+        }
+    }
+    return true;
+}
