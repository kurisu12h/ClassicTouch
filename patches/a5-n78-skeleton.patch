@@ -62,7 +62,8 @@
 
 OBJECT_DECLARE_SIMPLE_TYPE(S5L8930CDMAState, S5L8930_CDMA)
 
-#define CDMA_CHANNELS       S5L8930_CDMA_CHANNELS
+#define CDMA_CHANNELS       S5L8930_CDMA_CHANNELS   /* the A4's; what a snapshot holds */
+#define CDMA_MAX_CHANNELS   0x30                    /* "channels": the A5 has 0x2b */
 #define CDMA_CHAN_SHIFT     12
