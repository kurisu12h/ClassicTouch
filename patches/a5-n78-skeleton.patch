+/*
+ * The guest-services trap (mcr p15,3,Rn,c15,c15,0, "QEMU_CALL") the GLES front in the system volume
+ * uses, as on the A4 machine (hw/arm/ipad1.c): without it iOS 7's backboardd dies on its first GL
+ * call with SIGILL (0xee6f6f1f). The GL bridge and the guest-package service answer here (the GL
+ * front's hello, which agrees the name-keyed wire, goes through the latter: without it the front
+ * logs "the host speaks another wire protocol"); the agent and the pasteboard are not wired yet.
+ */
+static void n78_qemu_call(CPUARMState *env, const ARMCPRegInfo *ri, uint64_t value)
+{
+    CPUState *cs = env_cpu(env);
+    N78MachineState *s = N78_MACHINE(qdev_get_machine());
+    qemu_call_t q;
+    int32_t err = 0;
+
+    if (qemu_call_rw(cs, value, &q, false)) {
+        return;
+    }
+    switch (q.call_number) {
+    case QC_GLES:
+        q.retval = qc_handle_gles(cs, &q.args.gles);
+        break;
+    case QC_GLES_PING:
+        q.retval = QC_GLES_PING_MAGIC;
+        break;
+    default:
+        if (!guest_pkg_call(&s->pkg, cs, &q, &err)) {
+            return;
+        }
+    }
+    q.error = err;
+    qemu_call_rw(cs, value, &q, true);
+}
+
+static const ARMCPRegInfo n78_cp_reginfo[] = {
+    { .name = "QEMU_CALL", .cp = 15, .opc1 = 3, .crn = 15, .crm = 15,
+      .opc2 = 0, .access = PL0_RW, .state = ARM_CP_STATE_AA32,
+      .type = ARM_CP_IO | ARM_CP_NO_RAW | ARM_CP_RAISES_EXC,
+      .readfn = qemu_call_status,
+      .writefn = n78_qemu_call },
+};
