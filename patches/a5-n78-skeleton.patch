+static void n78_kbd_event(DeviceState *dev, QemuConsole *src, InputEvent *evt)
+{
+    InputKeyEvent *key = evt->u.key.data;
+    int pin;
+
+    switch (qemu_input_key_value_to_qcode(key->key)) {
+    case Q_KEY_CODE_H:     pin = N78_GPIO_BTN_MENU; break;
+    case Q_KEY_CODE_L:     pin = N78_GPIO_BTN_HOLD; break;
+    case Q_KEY_CODE_EQUAL: pin = N78_GPIO_BTN_VOLUP; break;
+    case Q_KEY_CODE_MINUS: pin = N78_GPIO_BTN_VOLDN; break;
+    default:
+        return;
+    }
+    qemu_set_irq(qdev_get_gpio_in(dev, S5L8930_GPIO_PIN(pin)), !key->down);
+}
