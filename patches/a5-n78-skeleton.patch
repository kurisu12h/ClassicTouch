+/* The calling process's first-level table (TTBR0), 0 where the walk below cannot follow it (LPAE). */
+static uint64_t gles_owner_ttbr(CPUState *cpu)
+{
+    CPUARMState *env = cpu_env(cpu);
+
+    return env->cp15.tcr_el[1] & (1u << 31) ? 0 : env->cp15.ttbr0_el[1];
+}
+
+/*
+ * Where the page tables at `ttbr` (short descriptors, TTBCR.N as now) put `va`: 1 with its RAM offset,
+ * 0 unmapped or not RAM, -1 when they cannot be followed here (an address for TTBR1, a v5 fine table).
+ */
+static int gles_owner_page(CPUState *cpu, uint64_t ttbr, vaddr va, ram_addr_t *ram)
+{
+    unsigned n = cpu_env(cpu)->cp15.tcr_el[1] & 7;
+    uint32_t d1, d2;
+    hwaddr pa, xlat, len = 1;
+    MemoryRegion *mr;
+
+    if (n && va >> (32 - n)) return -1;
+    d1 = address_space_ldl_le(&address_space_memory, ((uint32_t)ttbr & ~((1u << (14 - n)) - 1)) + (va >> 20) * 4,
+                              MEMTXATTRS_UNSPECIFIED, NULL);
+    switch (d1 & 3) {
+    case 1:
+        d2 = address_space_ldl_le(&address_space_memory, (d1 & ~0x3ffu) + ((va >> 12) & 0xff) * 4,
+                                  MEMTXATTRS_UNSPECIFIED, NULL);
+        if (d2 & 2) {
+            pa = (d2 & ~0xfffu) | (va & 0xfff);
+        } else if (d2 & 1) {
+            pa = (d2 & 0xffff0000u) | (va & 0xffff);
+        } else {
+            return 0;
+        }
+        break;
+    case 2:
+        pa = d1 & (1u << 18) ? (d1 & 0xff000000u) | (va & 0xffffff) : (d1 & 0xfff00000u) | (va & 0xfffff);
+        break;
+    case 3:
+        return -1;
+    default:
+        return 0;
+    }
+    WITH_RCU_READ_LOCK_GUARD() {
+        mr = address_space_translate(&address_space_memory, pa, &xlat, &len, false, MEMTXATTRS_UNSPECIFIED);
+        if (!memory_region_is_ram(mr)) return 0;
+        *ram = memory_region_get_ram_addr(mr) + xlat;
+    }
+    return 1;
+}
