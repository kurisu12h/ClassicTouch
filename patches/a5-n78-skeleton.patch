+/*
+ * Apple Swift, the A6's (S5L8950X) and A6X's cores: ARMv7s, which is ARMv7-A with VFPv4, the integer divides in
+ * both instruction sets and the multiprocessing extensions, so this is QEMU's Cortex-A15 under Apple's MIDR:
+ * implementer 0x61 (xnu osfmk/arm/cpuid.h CPU_VID_APPLE), part 0 (CPU_PART_SWIFT), which xnu calls
+ * CPUFAMILY_ARM_SWIFT. Used by the iPhone 5 machine (hw/arm/ipod_touch_5g.c).
+ */
+static void apple_swift_initfn(Object *obj)
+{
+    ARMCPU *cpu = ARM_CPU(obj);
+
+    cortex_a15_initfn(obj);
+    cpu->dtb_compatible = "apple,swift";
+    cpu->midr = 0x610f0000;
+    /*
+     * The A6's L2: 1 MiB, 8 ways of 64-byte lines, 2048 sets. xnu's vm_page_set_colors takes the page colours
+     * from it (sets x line / page = 32) and panics on a count that is no power of two, which the A15's L2
+     * (2304 sets x 16 ways: 36 colours) is.
+     */
+    cpu->ccsidr[2] = 0x70ffe03a;
+}
