+/* EAGL lifetime for the per-context executor on iOS, included by gles-host.c in place of
+ * ANGLE's EGL one. Each guest context has an EAGLContext of its own: ES 3.0 for a guest
+ * ES 2.0 context (what ANGLE gives too, and it runs the guest's ES 2.0 shaders as they
+ * are), ES 1.1 for the rest, since EAGL runs no fixed function in a programmable context
+ * nor shaders in an ES1 one. A group's contexts share the root's EAGLSharegroup. The
+ * Objective-C is in gles-host-eagl.c; past this, the ES adapters are ANGLE's
+ * (gles-host-angle.c.inc), which read the current context through angle_current. */
+#define CGLContextObj GLESEaglContextRef
+#define CGLSetCurrentContext gles_eagl_set_current_ctx
+#define CGLRetainContext gles_eagl_retain
+#define CGLReleaseContext gles_eagl_release_ctx
+typedef struct GLESEaglContext {
+    void *context;          /* the EAGLContext, retained */
+    unsigned refs;
+    bool es2;
+    GLint row_length;       /* GL_UNPACK_ROW_LENGTH in an ES1 context (gles-host-angle.c.inc) */
+    GLuint rect[8];
+    bool rect_on[8];
+    GHashTable *rect_size;
+    GHashTable *fences;     /* APPLE_fence: the context's fence names, to whether one is set */
+    GLuint next_fence;
+} *CGLContextObj;
+static __thread CGLContextObj angle_current;
+
+void *gles_eagl_context_new(unsigned api, void *share);
+bool gles_eagl_context_set_current(void *context);
+void gles_eagl_context_release(void *context);
+
+static bool gles_eagl_create(CGLContextObj share, bool es2, CGLContextObj *out)
+{
+    void *context = gles_eagl_context_new(es2 ? 3 : 1, share ? share->context : NULL);
+    if (!context) return false;
+    CGLContextObj c = g_new0(struct GLESEaglContext, 1);
+    c->context = context;
+    c->refs = 1;
+    c->es2 = es2;
+    c->rect_size = share ? g_hash_table_ref(share->rect_size) : g_hash_table_new(g_direct_hash, g_direct_equal);
+    c->fences = g_hash_table_new(g_direct_hash, g_direct_equal);
+    *out = c;
+    return true;
+}
+static int CGLSetCurrentContext(CGLContextObj c)
+{
+    if (angle_current == c) return 0;
+    if (!gles_eagl_context_set_current(c ? c->context : NULL)) return -1;
+    angle_current = c;
+    return 0;
+}
+static CGLContextObj CGLRetainContext(CGLContextObj c) { c->refs++; return c; }
+static void CGLReleaseContext(CGLContextObj c)
+{
+    if (--c->refs) return;
+    if (angle_current == c) CGLSetCurrentContext(NULL);
+    gles_eagl_context_release(c->context);
+    g_hash_table_unref(c->rect_size);
+    g_hash_table_destroy(c->fences);
+    g_free(c);
+}
+
+/* APPLE_fence, which iOS has no NV_fence to stand in for: the answers ANGLE's give
+ * (gles-host-angle.c.inc), every fence complete once set, kept per context as GL keeps
+ * fence names. */
+static void glGenFencesAPPLE(GLsizei n, GLuint *fences)
+{
+    for (GLsizei i = 0; angle_current && i < n; i++) {
+        do fences[i] = ++angle_current->next_fence;
+        while (!fences[i] || g_hash_table_contains(angle_current->fences, GUINT_TO_POINTER(fences[i])));
+        g_hash_table_insert(angle_current->fences, GUINT_TO_POINTER(fences[i]), GINT_TO_POINTER(0));
+    }
+}
+static void glDeleteFencesAPPLE(GLsizei n, const GLuint *fences)
+{
+    for (GLsizei i = 0; angle_current && i < n; i++) {
+        g_hash_table_remove(angle_current->fences, GUINT_TO_POINTER(fences[i]));
+    }
+}
+static void glSetFenceAPPLE(GLuint fence)
+{
+    if (angle_current && fence) {
+        g_hash_table_insert(angle_current->fences, GUINT_TO_POINTER(fence), GINT_TO_POINTER(1));
+    }
+}
+static GLboolean glIsFenceAPPLE(GLuint fence)
+{
+    return angle_current && g_hash_table_lookup(angle_current->fences, GUINT_TO_POINTER(fence));
+}
