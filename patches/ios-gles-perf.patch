+/*
+ * A glFlush with an offscreen framebuffer bound: write back that framebuffer's surface, and any other
+ * that has been rendered and left unwritten for a while, but not the one the frame is in the middle of.
+ * iOS 7's CoreAnimation draws a frame into its display surface, steps out to an offscreen target for a
+ * layer's pass (a backdrop, a mask, an icon's group), flushes there and steps back, a dozen to two dozen
+ * times a frame on the lock screen and Home; gles_surface_flush wrote the half-drawn display surface back
+ * into guest memory at every one of those flushes, and the only copy anyone reads is the one written when
+ * the frame returns to the default framebuffer (or at glFinish) and the panel latches it. On the phone a
+ * full-screen readback costs 6 to 14 ms, so that was most of the vCPU thread (docs/reports/m2-ios7-perf.md).
+ * A surface another context or the CPU reads is still written: at its own framebuffer's flush, at the
+ * frame's end, when this group binds its memory as a texture (gles_bind_surface), or once it has been
+ * dirty GLES_FLUSH_STALE_NS, for a client that renders, steps away and flushes for another reader.
+ */
+#define GLES_FLUSH_STALE_NS (50 * 1000 * 1000)
+static int gles_surface_flush_partial(CPUState *cpu)
+{
+    GHashTableIter it;
+    gpointer key, value;
+    GLint kind = 0, texture = 0;
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_REALTIME);
+
+    if (!gh.surfaces) return 0;
+    glGetFramebufferAttachmentParameterivEXT(GL_FRAMEBUFFER_EXT,
+        GL_COLOR_ATTACHMENT0_EXT, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE_EXT, &kind);
+    if (kind == GL_TEXTURE) glGetFramebufferAttachmentParameterivEXT(GL_FRAMEBUFFER_EXT,
+        GL_COLOR_ATTACHMENT0_EXT, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME_EXT, &texture);
+    g_hash_table_iter_init(&it, gh.surfaces);
+    while (g_hash_table_iter_next(&it, &key, &value)) {
+        GLESSurface *s = value;
+        if (s->dirty && ((GLint)GPOINTER_TO_UINT(key) == texture || now - s->dirty_since >= GLES_FLUSH_STALE_NS) &&
+            gles_surface_writeback(cpu, GPOINTER_TO_UINT(key), s)) return -1;
+    }
+    return 0;
+}
