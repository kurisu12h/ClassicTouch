+        const char *v = getenv("IT_PERF");
+        gles_perf = v ? atoi(v) : 0;
+        v = getenv("IT_PERF_TRACE");
+        double from, to;
+        if (v && sscanf(v, "%lf,%lf", &from, &to) == 2) {
+            gles_trace_from = from * 1e9;
+            gles_trace_to = to * 1e9;
