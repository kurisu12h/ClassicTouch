+/* IT_PERF_TRACE_EVERY=S: the first 0.2 s of every S seconds of virtual time instead, so each stretch
+ * of a scripted run gets a sample whenever it falls. */
+static bool gles_tracing(void)
+{
+    static int64_t every = -1;
+    if (every < 0) {
+        const char *v = getenv("IT_PERF_TRACE_EVERY");
+        every = v ? atof(v) * 1e9 : 0;
+    }
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (every > 0) return now % every < 200000000;
+    return gles_trace_to && now >= gles_trace_from && now < gles_trace_to;
+}
+
+/* The line for the second that ended, once one has. */
+static void gles_perf_report(uint64_t now)
+{
+    if (now < gp.next) return;
+    if (gp.next) {
+        unsigned top[5] = { 0 };
+        for (unsigned i = 0; i < GLES_PERF_SLOTS; i++) {
+            for (unsigned k = 0; k < 5; k++) {
+                if (gp.slot_ns[i] > gp.slot_ns[top[k]]) {
+                    memmove(top + k + 1, top + k, (4 - k) * sizeof(top[0]));
+                    top[k] = i;
+                    break;
+                }
+            }
+        }
+        fprintf(stderr, "[perf] gl up=%.3f calls=%" PRIu64 " host-ms=%.1f err-ms=%.1f"
+                " upload=%" PRIu64 "/%.1fMB/%.1fms(fetch %.1fms)"
+                " writeback=%" PRIu64 "/%.1fMB/%.1fms(readpixels %.1fms) host-cpu-ms=%.1f readpixels-cpu-ms=%.1f"
+                " reread=%" PRIu64 "/%.1fMB top:",
+                now / 1e9, gp.calls, gp.call_ns / 1e6, gp.err_ns / 1e6,
+                gp.up_n, gp.up_bytes / 1048576.0, gp.up_ns / 1e6, gp.fetch_ns / 1e6,
+                gp.wb_n, gp.wb_bytes / 1048576.0, gp.wb_ns / 1e6, gp.rp_ns / 1e6,
+                gp.calls_cpu_ns / 1e6, gp.rp_cpu_ns / 1e6,
+                gp.recopy_n, gp.recopy_bytes / 1048576.0);
+        for (unsigned k = 0; k < 5 && gp.slot_ns[top[k]]; k++) {
+            if (top[k] <= GLES_ID_MAX) {
+                fprintf(stderr, " %s", gles_id_name(top[k]));
+            } else {
+                fprintf(stderr, " op%u", top[k] - GLES_ID_MAX - 1);
+            }
+            fprintf(stderr, "=%" PRIu64 "/%.1fms", gp.slot_n[top[k]], gp.slot_ns[top[k]] / 1e6);
+        }
+        fprintf(stderr, "\n");
+    }
+    uint64_t next = now - now % 1000000000ull + 1000000000ull;
+    memset(&gp, 0, sizeof(gp));
+    gp.next = next;
+}
