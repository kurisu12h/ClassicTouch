+/* The GL ids, then the engine's own operations (GLES_OP_*) by their number past GLES_OP_BASE. */
+static unsigned gles_perf_slot(uint32_t slot)
+{
+    if (slot <= GLES_ID_MAX) return slot;
+    if (slot >= GLES_OP_BASE && slot < GLES_OP_BASE + 16) return GLES_ID_MAX + 1 + slot - GLES_OP_BASE;
+    return GLES_PERF_SLOTS - 1;
+}
+
+static uint64_t gles_perf_now(void)
