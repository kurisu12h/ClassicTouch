+ * with the host's here): every writeback and flush in that window, one line each ("[trace]"), to
+ * see which surfaces a frame writes back. s5l8930_display.c traces its swaps in the same window. */
+static int64_t gles_trace_from, gles_trace_to;
+
+/* This thread's CPU time: what of the wall time above the thread spent running rather than waiting. */
+static uint64_t gles_perf_cpu(void)
+{
+#ifdef __APPLE__
+    return clock_gettime_nsec_np(CLOCK_THREAD_CPUTIME_ID);
+#else
+    struct timespec ts;
+    clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts);
