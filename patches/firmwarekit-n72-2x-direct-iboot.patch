             "machine": Self.machine.merging([
@@ -300,6 +303,21 @@ final class N72Board: Board {
             .first { FileManager.default.fileExists(atPath: $0.path) }
     }
 
+    /// ClassicTouch: 2.x lockdownd turns BrickState on at first boot and, on an iPod, only a paired host setting the
+    /// time clears it (SpringBoard stays on Connect to iTunes). Seed the persistent boolean off, as N45Recipe does for
+    /// 1.x, so no USB host is needed. Returns the paths to own as root.
+    static func seedBrickState(_ v: any VolumeFiles) throws -> [(UInt32, String)] {
+        let library = "private/var/root/Library"
+        let lockdown = library + "/Lockdown"
+        let ark = lockdown + "/data_ark.plist"
+        var owned: [(UInt32, String)] = []
+        if !v.exists(library) { owned.append((0, library)) }
+        if !v.exists(lockdown) { owned.append((0, lockdown)) }
+        try SystemEdits.seedPlist(v, ark) { $0["-BrickState"] = false }
+        owned.append((0, ark))
+        return owned
+    }
+
     static func firstMatch(_ d: Data, _ r: Regex<Substring>) -> String? {
         String(decoding: d, as: UTF8.self).firstMatch(of: r).map { String($0.output) }
     }
