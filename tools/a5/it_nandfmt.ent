<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- the stock 13G36 restored_external's set (this helper replaces it in a private RAM disk copy); 9.x's
	     platform sandbox refuses raw disks without disk-device-access. 7.1.2 needs none of them. -->
	<key>com.apple.keystore.fdr-access</key>
	<true/>
	<key>com.apple.keystore.obliterate-d-key</key>
	<true/>
	<key>com.apple.private.IOAESAccelerator.fdr-key-handle</key>
	<true/>
	<key>com.apple.private.security.disk-device-access</key>
	<true/>
</dict>
</plist>
