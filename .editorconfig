root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,swift,c,h}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

# Patches and Markdown keep their whitespace exactly: a trailing space can be part of a diff line or a line break.
[*.{patch,md}]
trim_trailing_whitespace = false
